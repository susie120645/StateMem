        sys.path.append(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
        from memoryos.memoryos import Memoryos

class HotpotAMEMEvaluator:
    def __init__(self, trace_path="amem_hotpot_traces.jsonl"):
        # 每次启动清理旧数据，确保测试纯净度（验证代谢流转的真实性）
        self.storage_path = "./eval_storage_v2"
        if os.path.exists(self.storage_path):
            shutil.rmtree(self.storage_path)

        self.memo = Memoryos(
            user_id="benchmark_user",
            openai_api_key="ollama", 
            openai_base_url="http://localhost:11434/v1",
            data_storage_path=self.storage_path,
            llm_model="qwen2.5:7b",
            short_term_capacity=20  # 故意缩小容量，让“溢出到遗忘池”的代谢逻辑频繁触发
        )
        self.trace_file = trace_path
        # 清空旧的 trace 文件
        if os.path.exists(self.trace_file):
            os.remove(self.trace_file)

    def evaluate_sample(self, item):
        """ 单个样本测试逻辑：写入 -> 代谢 -> 检索 -> 答题 """
        
        # --- 1. 注入 Context (模拟 A-MEM G0 写入) ---
        for title, sentences in item['context']:
            context_text = "".join(sentences)
            # 这里内部会调用 original_add_memory 并生成唯一的 page_id
            self.memo.add_memory(f"Knowledge from {title}", context_text)
        
        # --- 2. 强制触发代谢 (Metabolism) ---
        # 模拟大量对话后的池化流转：STM -> (G2) -> LTM Index / Forget Pool
        # 💡 修改点：对齐新版 Updater 接口
        self.memo.updater.process_short_term_to_routing()

        # --- 3. 检索与生成 (A-MEM G1 打捞) ---
        query = item['question']
        start_t = time.time()
        
        # 💡 调用核心 get_response。它内部会自动执行：
        #    retriever.retrieve_context(query) -> 获取打捞后的原文 -> 调用 LLM
        ai_ans = self.memo.get_response(query) 
        latency = time.time() - start_t

        # --- 4. 结果采集 ---
        gold_ans = item['answer'].lower()
        # 简单的 EM (Exact Match) 逻辑
        em = 1.0 if gold_ans in ai_ans.lower() else 0.0
        
        # 记录详细 Trace 以便后续分析打捞率
        record = {
            "id": item.get("_id", "unknown"),
            "q": query,
            "gold": item['answer'],
            "ai": ai_ans,
            "em": em,
            "latency": round(latency, 2),
            "hit_ids": self.memo.current_session_hit_ids
        }
        
        with open(self.trace_file, "a", encoding='utf-8') as f:
            f.write(json.dumps(record, ensure_ascii=False) + "\n")
        
        return em

def run_experiment(limit=20):
    # 请确保你的数据集路径正确
    data_path = "./data/hotpot/hotpot_dev_distractor_v1.json"
    if not os.path.exists(data_path):
        # 尝试备用路径
        data_path = os.path.join(os.path.dirname(__file__), "../data/hotpot/hotpot_dev_distractor_v1.json")
        if not os.path.exists(data_path):
            print(f"❌ Error: Data not found at {data_path}")
            return

    try:
        with open(data_path, 'r', encoding='utf-8') as f:
            data = json.load(f)
    except Exception as e:
        print(f"❌ Failed to load JSON data: {e}")
        return

    if not data:
        print("❌ Dataset is empty.")
        return

    evaluator = HotpotAMEMEvaluator()
    all_ems = []

    print(f"🚀 A-MEM Metabolism Testing: Running {min(limit, len(data))} samples")
    print(f"📂 Storage: {evaluator.storage_path}")
    print("-" * 50)
    
    for i, item in enumerate(data[:limit]):
        try:
            # 执行核心测试
            em = evaluator.evaluate_sample(item)
            all_ems.append(em)
            
            # 实时进度条
            status = "✅" if em > 0 else "❌"
            current_acc = mean(all_ems) if all_ems else 0
            print(f"[{i+1:03d}] {status} EM: {current_acc:.2%} | ID: {item.get('_id')}")
            
        except Exception as e:
            print(f"🔥 Error at sample {i}: {str(e)}")
            traceback.print_exc() # 打印堆栈以便定位具体的类成员报错
            continue

    # --- 最终结果统计 (防御空列表) ---
    print("\n" + "="*40)
    if not all_ems:
        print("❌ Final Result: No samples were processed successfully.")
    else:
        print(f"🏆 Final Benchmark Result: {mean(all_ems):.2%}")
    print("="*40)

if __name__ == "__main__":
    # 第一次运行建议 limit=5 快速看一眼 Traceback
    run_experiment(limit=20)