# --- 2. 评价指标函数 (EM & F1) ---
def compute_em(prediction, ground_truth):
    def normalize_answer(s):
        return re.sub(r'\b(a|an|the)\b', ' ', s.lower()).strip()
    return 1.0 if normalize_answer(ground_truth) in normalize_answer(prediction) else 0.0

def compute_f1(prediction, ground_truth):
    prediction_tokens = prediction.lower().split()
    ground_truth_tokens = ground_truth.lower().split()
    common = set(prediction_tokens) & set(ground_truth_tokens)
    if not common: return 0.0
    precision = len(common) / len(prediction_tokens)
    recall = len(common) / len(ground_truth_tokens)
    return 2 * (precision * recall) / (precision + recall)

# --- 3. 评测执行类 ---
class HotpotEvaluator:
    def __init__(self, storage_name="eval_results_hotpot"):
        self.data_storage_path = os.path.join(project_root, storage_name)
        print("🚀 Initializing MemoryOS Agent...")
        self.memo = Memoryos(
            user_id="benchmark_user",
            openai_api_key="ollama",
            openai_base_url="http://localhost:11434/v1",
            data_storage_path=self.data_storage_path,
            llm_model="qwen2.5:7b",
            embedding_model_name="nomic-embed-text",
            short_term_capacity=10 
        )

    def run_single_sample(self, item):
        """处理单个 HotpotQA 样本的核心逻辑"""
        # 1. 注入上下文 (Fact Injection)
        for title, sentences in item['context']:
            context_block = "".join(sentences)
            # A-MEM 此时会通过 G0 评估并存入 STM
            self.memo.add_memory(
                user_input=f"Background Info - {title}", 
                agent_response=context_block
            )

        # 2. 触发语义固化 (MTM Consolidation)
        # 这一步是 A-MEM 的核心，它将碎片 context 合并为语义 Session
        self.memo.updater.process_short_term_to_mid_term()

        # 3. 提问与计时
        start_t = time.time()
        # 注意：这里需要根据你的 Memoryos 方法名选择 get_response 或 generate_response
        ai_response = self.memo.get_response(item['question']) 
        duration = time.time() - start_t

        # 4. 计算指标
        em = compute_em(ai_response, item['answer'])
        f1 = compute_f1(ai_response, item['answer'])

        return {
            "id": item["_id"],
            "question": item["question"],
            "gold": item["answer"],
            "ai": ai_response,
            "em": em,
            "f1": f1,
            "latency": duration
        }

def batch_evaluate(start_idx=0, count=50):
    """批量评测主入口"""
    data_path = os.path.join(project_root, "data/hotpot/hotpot_dev_distractor_v1.json")
    output_path = os.path.join(project_root, f"benchmark_report_{start_idx}_{start_idx+count}.json")
    
    if not os.path.exists(data_path):
        print(f"❌ Error: Data file not found at {data_path}. Please download it first.")
        return

    with open(data_path, 'r', encoding='utf-8') as f:
        all_samples = json.load(f)

    samples = all_samples[start_idx : start_idx + count]
    evaluator = HotpotEvaluator()
    results = []

    print(f"📊 Starting Batch: {start_idx} to {start_idx + count} (Total: {len(samples)})")
    
    for i, item in enumerate(samples):
        curr_idx = start_idx + i
        try:
            res = evaluator.run_single_sample(item)
            results.append(res)
            print(f"[{curr_idx}] EM: {res['em']} | F1: {res['f1']:.2f} | Latency: {res['latency']:.2f}s")
            
            # 每 5 组保存一次中间结果
            if (i + 1) % 5 == 0:
                with open(output_path, 'w', encoding='utf-8') as f:
                    json.dump(results, f, indent=2, ensure_ascii=False)
                print(f"💾 Checkpoint saved at index {curr_idx}")

        except Exception as e:
            print(f"⚠️ Failed at index {curr_idx}: {e}")
            time.sleep(2) # 遇到错误停顿，防止 Ollama 崩溃循环
            continue

    # 最终汇总统计
    if results:
        avg_em = mean([r['em'] for r in results])
        avg_f1 = mean([r['f1'] for r in results])
        print("\n" + "="*40)
        print(f"🏁 Batch {start_idx} - {start_idx+count} Complete")
        print(f"Average EM: {avg_em:.2%}")
        print(f"Average F1: {avg_f1:.4f}")
        print("="*40)

    with open(output_path, 'w', encoding='utf-8') as f:
        json.dump(results, f, indent=2, ensure_ascii=False)

if __name__ == "__main__":
    # --- 实验配置区 ---
    # 你可以在这里指定从哪里开始跑，跑多少组
    # 第一次建议跑 50 组，通常需要 20-30 分钟（取决于显卡）
    START = 0
    COUNT = 50
    
    batch_evaluate(start_idx=START, count=COUNT)