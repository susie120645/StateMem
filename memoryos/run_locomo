def normalize_text(text: object) -> str:
    text = str(text or "").lower().strip()
    text = re.sub(r"\b(a|an|the|my|your|his|her|their|our)\b", " ", text)
    text = re.sub(r"[^a-z0-9\s]", " ", text)
    text = " ".join(text.split())
    return text


def _coerce_salvage_count(record: Dict[str, Any]) -> int:
    if not isinstance(record, dict):
        return 0
    value = record.get("salvage_count")
    if value is None:
        source_stats = record.get("source_stats", {})
        if isinstance(source_stats, dict):
            value = source_stats.get("FORGET_COLD", 0)
    try:
        return max(0, int(value))
    except (TypeError, ValueError):
        return 0


def summarize_salvage_metrics(records: List[Dict[str, Any]]) -> Dict[str, Any]:
    salvage_counts = [_coerce_salvage_count(record) for record in records]
    question_count = len(salvage_counts)
    total_salvage_count = sum(salvage_counts)
    questions_with_salvage = sum(1 for count in salvage_counts if count > 0)
    return {
        "forget_pool_salvage_count": total_salvage_count,
        "questions_with_forget_pool_salvage": questions_with_salvage,
        "forget_pool_salvage_rate": round(questions_with_salvage / question_count, 4) if question_count else 0.0,
        "avg_forget_pool_salvage_count": round(total_salvage_count / question_count, 4) if question_count else 0.0,
    }


