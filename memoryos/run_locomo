    if "what instruments" in q_lower:
        if re.search(r"\bclarinet\b", corpus, re.I):
            parts.append("clarinet")
        if re.search(r"\bviolin\b", corpus, re.I):
            parts.append("violin")
        items = dedupe_list_items(parts)
        if len(items) >= 2:
            return " and ".join(items[:2])

    if "what items" in q_lower and "bought" in q_lower:
        if re.search(r"\bfigurines?\b", corpus, re.I):
            parts.append("Figurines")
        if re.search(r"\bshoes?\b", corpus, re.I):
            parts.append("Shoes")
        items = dedupe_list_items(parts)
        if len(items) >= 2:
            return ", ".join(items)

    if q_lower.startswith("how does ") and "self-care" in q_lower:
        actions = []
        if re.search(r"\brunning\b", corpus, re.I):
            actions.append("running")
        if re.search(r"\breading\b", corpus, re.I):
            actions.append("reading")
        if re.search(r"\bviolin\b", corpus, re.I):
