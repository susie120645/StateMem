def extract_best_temporal_answer_from_evidence(question: str, retrieval_results: Dict, limit: int = 12) -> Optional[str]:
    q_lower = question.lower().strip()
    question_terms = extract_question_terms(question)
    lines = collect_relevant_evidence_lines(question, retrieval_results, limit=limit)
    best_line = find_best_matching_evidence_line(question, retrieval_results)
    if best_line and best_line not in lines:
        lines.insert(0, best_line)

    full_date_pattern = r"\b(\d{1,2}\s+[A-Za-z]+,?\s+\d{4})\b"
    year_pattern = r"\b(19\d{2}|20\d{2}|21\d{2})\b"
    duration_pattern = (
        r"\bfor (?:about |around |almost )?"
        r"(\d+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve)\s+years?\b"
    )
    candidates: List[Tuple[float, str]] = []

    for index, line in enumerate(lines):
        line_lower = line.lower()
        base_score = score_evidence_line(question, line, question_terms=question_terms, temporal=True) - (0.05 * index)
        if "exact time:" in line_lower:
            base_score += 2.0
        if "resolved time:" in line_lower or "resolved relative times:" in line_lower:
            base_score += 1.4

        if q_lower.startswith("which year"):
            for match in re.finditer(year_pattern, line):
                candidates.append((base_score, match.group(1)))
            continue

        if q_lower.startswith("how long"):
            for match in re.finditer(duration_pattern, line, re.I):
                candidates.append((base_score, match.group(0)))
            continue

        if not q_lower.startswith("when"):
            continue

        for pattern in (
            r"\b(?:a|one)\s+week\s+before\s+\d{1,2}\s+[A-Za-z]+,?\s*\d{4}\b",
            r"\bweek before \d{1,2}\s+[A-Za-z]+,?\s*\d{4}\b",
        ):
            match = re.search(pattern, line, re.I)
            if match:
                candidates.append((base_score + 1.0, match.group(0)))

        for match in re.finditer(full_date_pattern, line):
            date_score = base_score
            if "->" in line_lower:
                date_score += 0.8
            if "date:" in line_lower:
                date_score += 0.4
            candidates.append((date_score, match.group(1)))

    if not candidates:
        return None

    candidates.sort(key=lambda item: item[0], reverse=True)
    return candidates[0][1]


def postprocess_temporal_answer(question: str, answer: str, retrieval_results: Dict) -> str:
    answer = (answer or "").strip()
    q_lower = question.lower().strip()
    best_line = find_best_matching_evidence_line(question, retrieval_results)
    multifact_answer = derive_multifact_answer(question, retrieval_results)
    evidence_answer = extract_best_temporal_answer_from_evidence(question, retrieval_results)
    normalized_answer = normalize_text(answer)
    answer_is_error = answer.lower().startswith("error:") or answer.lower().startswith("simulated response:")
    answer_temporal_forms = extract_temporal_canonical_forms(answer)
    if multifact_answer:
        return multifact_answer

    if q_lower.startswith("which year"):
        for source in [answer, evidence_answer or "", best_line]:
            match = re.search(r"\b(19\d{2}|20\d{2}|21\d{2})\b", source)
            if match:
                return match.group(1)

    if q_lower.startswith("how long"):
        for source in [answer, evidence_answer or "", best_line]:
            match = re.search(
                r"\bfor (?:about |around |almost )?(\d+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve)\s+years?\b",
                source,
                re.I,
            )
            if match:
                return match.group(0)

    if q_lower.startswith("when"):
        full_date_pattern = r"\b(\d{1,2}\s+[A-Za-z]+,?\s+\d{4})\b"
        match = re.search(full_date_pattern, answer)
        if match:
            return match.group(1)

        for pattern in (
            r"\b(?:a|one)\s+week\s+before\s+\d{1,2}\s+[A-Za-z]+,?\s*\d{4}\b",
            r"\bweek before \d{1,2}\s+[A-Za-z]+,?\s*\d{4}\b",
        ):
            match = re.search(pattern, answer, re.I)
            if match:
                return match.group(0)

        if re.search(r"\bweek of \d", answer, re.I):
            match = re.search(r"\b(?:a|one)\s+week\s+before\s+\d{1,2}\s+[A-Za-z]+,?\s*\d{4}\b", evidence_answer or best_line, re.I)
            if match:
                return match.group(0)
            match = re.search(r"\bweek before \d{1,2}\s+[A-Za-z]+,?\s*\d{4}\b", evidence_answer or best_line, re.I)
            if match:
                return match.group(0)

        if re.fullmatch(r"\d{1,2}", answer):
            match = re.search(full_date_pattern, evidence_answer or best_line)
            if match:
                return match.group(1)

        if normalized_answer == "unknown" or answer_is_error or not answer_temporal_forms:
            match = re.search(full_date_pattern, evidence_answer or best_line)
            if match:
                return match.group(1)
            if evidence_answer:
                return evidence_answer

    if "besides studying" in q_lower:
        answer = re.sub(r"^\s*studying\s+and\s+", "", answer, flags=re.I).strip()
        answer = re.sub(r"^\s*studying,\s*", "", answer, flags=re.I).strip()

    return answer


def collect_session_time_resolutions(session_summary: str, event_summary: Dict, observation: Dict, turns: List[Dict], anchor: Optional[datetime]) -> List[str]:
    if anchor is None:
        return []
    notes: List[str] = []

    def add_from_text(text: object) -> None:
        for resolution in resolve_relative_time_expressions(str(text or ""), anchor):
            if resolution not in notes:
                notes.append(resolution)

    add_from_text(session_summary)

    for events in event_summary.values():
        if isinstance(events, list):
            for event in events:
                add_from_text(event)
        else:
            add_from_text(events)

    for items in observation.values():
        if not isinstance(items, list):
            continue
        for item in items:
            if isinstance(item, list) and item:
                add_from_text(item[0])
            else:
                add_from_text(item)

    for turn in turns:
        add_from_text(turn.get("text", ""))

    return notes[:12]


def collect_time_resolved_event_facts(observation: Dict, event_summary: Dict, turns: List[Dict], anchor: Optional[datetime]) -> List[str]:
    if anchor is None:
        return []

    facts: List[str] = []

    def add_fact(prefix: str, text: object) -> None:
        text_str = " ".join(str(text or "").split())
        if not text_str:
            return
        resolutions = resolve_relative_time_expressions(text_str, anchor)
        if not resolutions:
            return
        fact = f"- {prefix}: {text_str} Exact time: {'; '.join(resolutions)}."
        if fact not in facts:
            facts.append(fact)

    for speaker, events in event_summary.items():
        if speaker == "date" or not events:
            continue
        if isinstance(events, list):
            for event in events:
                add_fact(speaker, event)
        else:
            add_fact(speaker, events)

    for speaker, speaker_observations in observation.items():
        if not isinstance(speaker_observations, list):
            continue
        for item in speaker_observations:
            if isinstance(item, list) and item:
                add_fact(speaker, item[0])
            else:
                add_fact(speaker, item)

    for turn in turns:
        add_fact(turn.get("speaker", "Unknown"), turn.get("text", ""))

    return facts[:12]


def format_turn(turn: Dict, anchor: Optional[datetime] = None) -> List[str]:
    speaker = turn.get("speaker", "Unknown")
    dia_id = turn.get("dia_id", "")
    prefix = f"[{dia_id}] {speaker}: " if dia_id else f"{speaker}: "
    text = str(turn.get("text", ""))
    lines = [prefix + text]
    resolutions = resolve_relative_time_expressions(text, anchor)
    if resolutions:
        lines.append(f"  Resolved Time: {'; '.join(resolutions)}")
    if turn.get("query"):
        lines.append(f"  Query Hint: {turn['query']}")
    if turn.get("blip_caption"):
        lines.append(f"  Image Caption: {turn['blip_caption']}")
    if turn.get("img_url"):
        lines.append(f"  Image URL: {', '.join(turn['img_url'])}")
    return lines


def sanitize_chunk_identifier(value: object) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "_", str(value or "unknown")).strip("._")
    return cleaned or "unknown"


def compact_lines(lines: List[str], max_items: int, max_chars: int) -> List[str]:
    compact: List[str] = []
    used = 0
    for line in lines[:max_items]:
        candidate = str(line or "").strip()
        if not candidate:
            continue
        projected = used + len(candidate) + (1 if compact else 0)
        if compact and projected > max_chars:
            break
        compact.append(candidate)
        used = projected
    return compact


def estimate_transcript_chars(turns: List[Dict], anchor: Optional[datetime]) -> int:
    total = 0
    for turn in turns:
        total += sum(len(line) for line in format_turn(turn, anchor=anchor)) + 1
    return total


def build_turn_windows(
    turns: List[Dict],
    anchor: Optional[datetime],
    window_size: int,
    window_overlap: int,
    max_chars: int,
) -> List[List[Dict]]:
    if not turns:
        return []

    size = max(1, int(window_size))
    overlap = max(0, min(int(window_overlap), size - 1))
    budget = max(240, int(max_chars))
    windows: List[List[Dict]] = []
    start = 0

    while start < len(turns):
        end = min(len(turns), start + size)
        selected = turns[start:end]

        while len(selected) > 1 and estimate_transcript_chars(selected, anchor) > budget:
            end -= 1
            selected = turns[start:end]

        if not selected:
            selected = [turns[start]]
            end = start + 1

        windows.append(selected)
        if end >= len(turns):
            break
        start = max(start + 1, end - overlap)

    return windows


def build_session_components(sample: Dict, session_id: int) -> Dict[str, Any]:
    conversation = sample["conversation"]
    date_time = conversation.get(f"session_{session_id}_date_time", "Unknown time")
    anchor_dt = parse_session_datetime(date_time)
    turns = conversation.get(f"session_{session_id}", [])
    session_summary = sample.get("session_summary", {}).get(
        f"session_{session_id}_summary",
        "",
    )
    observation = sample.get("observation", {}).get(f"session_{session_id}_observation", {})
    event_summary = sample.get("event_summary", {}).get(f"events_session_{session_id}", {})
    session_time_notes = collect_session_time_resolutions(
        session_summary=session_summary,
        event_summary=event_summary,
        observation=observation,
        turns=turns,
        anchor=anchor_dt,
    )
    resolved_event_facts = collect_time_resolved_event_facts(
        observation=observation,
        event_summary=event_summary,
        turns=turns,
        anchor=anchor_dt,
    )

    observation_lines: List[str] = []
    for speaker, speaker_observations in observation.items():
        if not isinstance(speaker_observations, list):
            continue
        for item in speaker_observations:
            if isinstance(item, list) and item:
                detail = item[0]
                evidence = item[1] if len(item) > 1 else ""
                observation_lines.append(
                    f"- {speaker}: {annotate_text_with_time_resolution(detail, anchor_dt)} ({evidence})"
                )
            elif item:
                observation_lines.append(f"- {speaker}: {annotate_text_with_time_resolution(item, anchor_dt)}")

    event_lines: List[str] = []
    for speaker, events in event_summary.items():
        if speaker == "date" or not events:
            continue
        if isinstance(events, list):
            for event in events:
                event_lines.append(f"- {speaker}: {annotate_text_with_time_resolution(event, anchor_dt)}")
        else:
            event_lines.append(f"- {speaker}: {annotate_text_with_time_resolution(events, anchor_dt)}")

    transcript_lines: List[str] = []
    for turn in turns:
        transcript_lines.extend(format_turn(turn, anchor=anchor_dt))

    return {
        "sample_id": sample.get("sample_id", "unknown"),
        "session_id": session_id,
        "date_time": date_time,
        "anchor_dt": anchor_dt,
        "turns": turns,
        "session_summary": session_summary,
        "observation": observation,
        "event_summary": event_summary,
        "session_time_notes": session_time_notes,
        "resolved_event_facts": resolved_event_facts,
        "observation_lines": observation_lines,
        "event_lines": event_lines,
        "transcript_lines": transcript_lines,
    }


def build_session_memory(sample: Dict, session_id: int) -> Tuple[str, str]:
    session = build_session_components(sample, session_id)
    body_parts = [
        f"Sample: {session['sample_id']}",
        f"Date: {session['date_time']}",
    ]
    if session["session_time_notes"]:
        body_parts.extend(["Resolved Relative Times:"] + [f"- {note}" for note in session["session_time_notes"]])
    if session["resolved_event_facts"]:
        body_parts.extend(["Resolved Event Facts:"] + session["resolved_event_facts"])
    if session["session_summary"]:
        body_parts.extend(["Session Summary:", annotate_text_with_time_resolution(session["session_summary"], session["anchor_dt"])])
    if session["event_lines"]:
        body_parts.extend(["Event Summary:"] + session["event_lines"])
    if session["observation_lines"]:
        body_parts.extend(["Observations:"] + session["observation_lines"])
    body_parts.extend(["Transcript:"] + session["transcript_lines"])

    user_input = f"Day {session_id} Record"
    agent_response = "\n".join(body_parts)
    return user_input, agent_response


def build_session_overview_memory(sample: Dict, session: Dict[str, Any]) -> Dict[str, Any]:
    session_id = session["session_id"]
    sample_key = sanitize_chunk_identifier(session["sample_id"])
    session_doc_id = f"{sample_key}_session_{session_id}"
    overview_page_id = f"{session_doc_id}_overview"

    body_parts = [
        f"Sample: {session['sample_id']}",
        f"Date: {session['date_time']}",
        f"Session: {session_id}",
    ]
    compact_time_notes = compact_lines([f"- {note}" for note in session["session_time_notes"]], max_items=8, max_chars=420)
    compact_event_facts = compact_lines(session["resolved_event_facts"], max_items=8, max_chars=640)
    compact_event_lines = compact_lines(session["event_lines"], max_items=8, max_chars=720)
    compact_observation_lines = compact_lines(session["observation_lines"], max_items=8, max_chars=720)

    if compact_time_notes:
        body_parts.extend(["Resolved Relative Times:"] + compact_time_notes)
    if compact_event_facts:
        body_parts.extend(["Resolved Event Facts:"] + compact_event_facts)
    if session["session_summary"]:
        body_parts.extend(["Session Summary:", annotate_text_with_time_resolution(session["session_summary"], session["anchor_dt"])])
    if compact_event_lines:
        body_parts.extend(["Event Summary:"] + compact_event_lines)
    if compact_observation_lines:
        body_parts.extend(["Observations:"] + compact_observation_lines)

    return {
        "user_input": f"LoCoMo Session {session_id} Overview",
        "agent_response": "\n".join(body_parts),
        "metadata": {
            "doc_id": overview_page_id,
            "page_id": overview_page_id,
            "session_group_id": session_doc_id,
            "conversation_id": session["sample_id"],
            "session_id": session_id,
            "session_datetime": session["date_time"],
            "chunk_scope": "session_overview",
            "source_dataset": "locomo",
            "topic": "LoCoMo Session Overview",
        },
    }


def build_session_transcript_memory(session: Dict[str, Any], session_doc_id: str, overview_page_id: str) -> Dict[str, Any]:
    session_id = session["session_id"]
    transcript_page_id = f"{session_doc_id}_transcript"
    body_parts = [
        f"Sample: {session['sample_id']}",
        f"Date: {session['date_time']}",
        f"Session: {session_id}",
    ]
    if session["session_summary"]:
        body_parts.extend(["Session Summary:", annotate_text_with_time_resolution(session["session_summary"], session["anchor_dt"])])
    body_parts.extend(["Transcript:"] + session["transcript_lines"])

    return {
        "user_input": f"LoCoMo Session {session_id} Transcript",
        "agent_response": "\n".join(body_parts),
        "metadata": {
            "doc_id": transcript_page_id,
            "page_id": transcript_page_id,
            "session_group_id": session_doc_id,
            "conversation_id": session["sample_id"],
            "session_id": session_id,
            "session_datetime": session["date_time"],
            "chunk_scope": "session_transcript",
            "source_dataset": "locomo",
            "topic": "LoCoMo Session Transcript",
            "pre_linked_ids": [overview_page_id],
        },
    }


def build_turn_window_memories(
    session: Dict[str, Any],
    session_doc_id: str,
    overview_page_id: str,
    window_size: int,
    window_overlap: int,
    max_chars: int,
) -> List[Dict[str, Any]]:
    windows = build_turn_windows(
        turns=session["turns"],
        anchor=session["anchor_dt"],
        window_size=window_size,
        window_overlap=window_overlap,
        max_chars=max_chars,
    )
    memories: List[Dict[str, Any]] = []
    session_id = session["session_id"]

    for index, window_turns in enumerate(windows, start=1):
        local_transcript_lines: List[str] = []
        dia_ids: List[str] = []
        for turn in window_turns:
            local_transcript_lines.extend(format_turn(turn, anchor=session["anchor_dt"]))
            dia_id = str(turn.get("dia_id", "")).strip()
            if dia_id:
                dia_ids.append(dia_id)

        dia_start = dia_ids[0] if dia_ids else ""
        dia_end = dia_ids[-1] if dia_ids else ""
        dia_range = f"{dia_start}-{dia_end}" if dia_start and dia_end and dia_start != dia_end else (dia_start or dia_end)

        body_parts = [
            f"Sample: {session['sample_id']}",
            f"Date: {session['date_time']}",
            f"Session: {session_id}",
            f"Window: {index}",
        ]
        if dia_range:
            body_parts.append(f"Dialogue IDs: {dia_range}")
        if session["session_summary"]:
            body_parts.extend(
                [
                    "Session Summary:",
                    annotate_text_with_time_resolution(session["session_summary"], session["anchor_dt"]),
                ]
            )
        body_parts.extend(["Transcript Window:"] + local_transcript_lines)

        memories.append(
            {
                "user_input": f"LoCoMo Session {session_id} Window {index}",
                "agent_response": "\n".join(body_parts),
                "metadata": {
                    "doc_id": f"{session_doc_id}_window_{index}",
                    "page_id": f"{session_doc_id}_window_{index}",
                    "session_group_id": session_doc_id,
                    "conversation_id": session["sample_id"],
                    "session_id": session_id,
                    "session_datetime": session["date_time"],
                    "chunk_scope": "turn_window",
                    "window_index": index,
                    "window_turn_count": len(window_turns),
                    "window_dia_ids": dia_ids,
                    "source_dataset": "locomo",
                    "topic": "LoCoMo Turn Window",
                    "pre_linked_ids": [overview_page_id],
                },
            }
        )

    return memories


def build_locomo_memory_entries(sample: Dict, session_id: int, args: argparse.Namespace) -> List[Dict[str, Any]]:
    session = build_session_components(sample, session_id)
    sample_key = sanitize_chunk_identifier(session["sample_id"])
    session_doc_id = f"{sample_key}_session_{session_id}"
    overview_page_id = f"{session_doc_id}_overview"

    memories: List[Dict[str, Any]] = [build_session_overview_memory(sample, session)]
    transcript_chars = estimate_transcript_chars(session["turns"], session["anchor_dt"])

    if transcript_chars <= args.session_transcript_max_chars:
        memories.append(build_session_transcript_memory(session, session_doc_id, overview_page_id))
        return memories

    memories.extend(
        build_turn_window_memories(
            session=session,
            session_doc_id=session_doc_id,
            overview_page_id=overview_page_id,
            window_size=args.turn_window_size,
            window_overlap=args.turn_window_overlap,
            max_chars=args.turn_window_max_chars,
        )
    )
    return memories


def build_context_block(question: str, retrieval_results: Dict, max_pages: int) -> str:
    pages = retrieval_results.get("retrieved_pages", [])[:max_pages]
    if not pages:
        return "No memory evidence retrieved."

    blocks = []
    focused_snippets = collect_focused_evidence_snippets(question, retrieval_results, limit=10)
    if focused_snippets:
        blocks.append("Focused Evidence:\n" + "\n".join(f"- {snippet}" for snippet in focused_snippets))
    relevant_lines = collect_relevant_evidence_lines(question, retrieval_results, limit=8)
    if relevant_lines:
        blocks.append("Relevant Lines:\n" + "\n".join(f"- {line}" for line in relevant_lines))

    for page in pages:
        citation_id = page.get("citation_id") or page.get("page_id") or "unknown"
        blocks.append(
            "\n".join(
                [
                    f"[{citation_id}]",
                    f"Prompt: {page.get('user_input', '')}",
                    f"Memory: {page.get('agent_response', '')}",
                ]
            )
        )
    return "\n\n".join(blocks)


def get_gold_answer(qa: Dict) -> str:
    answer = qa.get("answer")
    if answer not in {None, ""}:
        return str(answer).strip()
    adversarial_answer = qa.get("adversarial_answer")
    if adversarial_answer not in {None, ""}:
        return str(adversarial_answer).strip()
    return ""


def question_requires_inference(question: str) -> bool:
    q_lower = question.lower().strip()
    return (
        q_lower.startswith("would ")
        or " likely " in f" {q_lower} "
        or "considered" in q_lower
        or "political leaning" in q_lower
    )


def question_expects_list(question: str) -> bool:
    q_lower = question.lower().strip()
    list_markers = [
        "what activities",
        "what events",
        "what books",
        "what gifts",
        "what items",
        "what instruments",
        "what symbols",
        "what types",
        "what ways",
        "which countries",
        "which community activities",
    ]
    return any(marker in q_lower for marker in list_markers)


def has_actionable_evidence(question: str, retrieval_results: Dict) -> bool:
    focused = collect_focused_evidence_snippets(question, retrieval_results, limit=5)
    if focused:
        return True
    best_line = find_best_matching_evidence_line(question, retrieval_results)
    return bool(best_line and len(best_line.split()) >= 4)


def build_answer_prompt(question: str, context_block: str, inference_mode: bool, list_mode: bool) -> str:
    if inference_mode:
        task_rules = (
            "Inference Rule: infer the most likely answer only when the memory evidence shows a stable trait, preference, "
            "identity, habit, or long-term goal. If the evidence is weak or contradictory, answer 'Unknown'."
        )
    else:
        task_rules = (
            "Extraction Rule: prefer extracting the answer directly from evidence. "
            "Do not generalize if the evidence already states the answer."
        )

    list_rules = ""
    if list_mode:
        list_rules = "\nList Rule: return a concise comma-separated list of all supported items and no unsupported extras."

    return (
        f"{LOCOMO_SYSTEM_PROMPT}\n"
        f"{task_rules}"
        f"{list_rules}\n\n"
        f"Memory Evidence:\n{context_block}\n\n"
        f"Question: {question}\n"
        "Answer:"
    )


def retry_unknown_answer(
    memo: Memoryos,
    question: str,
    retrieval_results: Dict,
    answer_max_tokens: int,
    inference_mode: bool,
    list_mode: bool,
) -> str:
    focused_snippets = collect_focused_evidence_snippets(question, retrieval_results, limit=8)
    relevant_lines = collect_relevant_evidence_lines(question, retrieval_results, limit=8)
    evidence_lines = focused_snippets or relevant_lines
    if not evidence_lines:
        return "Unknown"

    retry_prompt = (
        "You previously answered 'Unknown'. Re-check the evidence below.\n"
        "If any line directly supports the answer, output the shortest supported answer only.\n"
        "Do not add unsupported details."
    )
    if inference_mode:
        retry_prompt += "\nIf the question asks what is likely or would happen, make a conservative inference only from repeated stable evidence."
    if list_mode:
        retry_prompt += "\nIf multiple supported items exist, return a concise comma-separated list of all supported items."
    retry_prompt += (
        "\nIf the evidence still does not support an answer, return 'Unknown'.\n\n"
        "Evidence:\n"
        + "\n".join(f"- {line}" for line in evidence_lines)
        + f"\n\nQuestion: {question}\nAnswer:"
    )
    answer = memo.client.chat_completion(
        model=memo.llm_model,
        messages=[{"role": "user", "content": retry_prompt}],
        temperature=0.0,
        max_tokens=answer_max_tokens,
    )
    return (answer or "").strip()


def collect_profile_evidence(question: str, retrieval_results: Dict, limit: int = 14) -> List[str]:
    names = [name.lower() for name in extract_question_names(question)]
    q_terms = {
        token
        for token in re.findall(r"[a-z0-9]+", question.lower())
        if token
        not in {
            "what",
            "when",
            "where",
            "which",
            "how",
            "why",
            "would",
            "likely",
            "might",
            "could",
            "should",
            "is",
            "are",
            "the",
            "a",
            "an",
            "her",
            "his",
            "their",
            "she",
            "he",
            "they",
        }
    }
    profile_markers = {
        "likes",
        "like",
        "loves",
        "enjoys",
        "enjoy",
        "favorite",
        "identity",
        "supportive",
        "support",
        "goal",
        "goals",
        "wants",
        "want",
        "career",
        "counseling",
        "mental",
        "books",
        "collects",
        "outdoors",
        "camping",
        "hiking",
        "faith",
        "church",
        "activist",
        "activism",
        "community",
        "classical",
        "music",
        "adoption",
        "roadtrip",
        "family",
        "religious",
    }
    scored: List[Tuple[float, str]] = []
    corpus = collect_retrieval_corpus(retrieval_results)

    for unit in split_into_evidence_units(corpus):
        lower = unit.lower()
        unit_terms = set(re.findall(r"[a-z0-9]+", lower))
        overlap = len(q_terms & unit_terms)
        if overlap == 0 and names and not any(name in lower for name in names):
            continue
        score = float(overlap)
        if names and any(name in lower for name in names):
            score += 1.0
        score += 0.35 * len(profile_markers & unit_terms)
        if any(marker in lower for marker in ["session summary:", "event summary:", "observations:"]):
            score -= 0.15
        if len(unit) > 320:
            score -= 0.2
        if score > 0.8:
            scored.append((score, unit))

    scored.sort(key=lambda item: item[0], reverse=True)
    result: List[str] = []
    for _, unit in scored:
        if unit not in result:
            result.append(unit)
        if len(result) >= limit:
            break
    return result


def derive_inference_answer(question: str, retrieval_results: Dict) -> Optional[str]:
    q_lower = question.lower().strip()
    corpus = collect_retrieval_corpus(retrieval_results)
    profile_lines = collect_profile_evidence(question, retrieval_results, limit=18)
    profile_corpus = "\n".join(profile_lines) if profile_lines else corpus

    if "what fields would" in q_lower and "education" in q_lower:
        parts = []
        if re.search(r"\bpsychology\b", profile_corpus, re.I):
            parts.append("Psychology")
        if re.search(r"counseling certification", profile_corpus, re.I):
            parts.append("counseling certification")
        elif re.search(r"\bcounseling\b", profile_corpus, re.I):
            parts.append("counseling")
        if len(parts) >= 2:
            return ", ".join(parts)

    if "dr. seuss" in q_lower and re.search(r"classic children'?s books|collects classic books", profile_corpus, re.I):
        return "Yes, since she collects classic children's books"

    if "writing as a career" in q_lower and re.search(r"counseling|mental health", profile_corpus, re.I):
        return "Likely no; though she likes reading, she wants to be a counselor"

    if "member of the lgbtq community" in q_lower:
        if re.search(r"ally|supportive|support the lgbtq community|supports the lgbtq community", profile_corpus, re.I):
            return "Likely no, she does not refer to herself as part of it"

    if "ally to the transgender community" in q_lower:
        if re.search(r"supportive|support the transgender community|voice to the trans community|support the lgbtq community", profile_corpus, re.I):
            return "Yes, she is supportive"

    if "political leaning" in q_lower:
        if re.search(r"activist|equality|acceptance|inclusion|lgbtq|trans community", profile_corpus, re.I):
            return "Liberal"

    if "considered religious" in q_lower:
        if re.search(r"church|faith", profile_corpus, re.I):
            return "Somewhat, but not extremely religious"

    if "national park or a theme park" in q_lower:
        if re.search(r"outdoors|camping|hiking|nature|national park", profile_corpus, re.I):
            return "National park; she likes the outdoors"

    if "the four seasons" in q_lower or "vivaldi" in q_lower:
        if re.search(r"classical music|classical musicians?|mozart|beethoven|vivaldi", profile_corpus, re.I):
            return "Yes; it's classical music"

    if "go on another roadtrip soon" in q_lower:
        if re.search(r"accident|went badly|rough road trip|stressful road trip", profile_corpus, re.I):
            return "Likely no; since this one went badly"

    if "move back to her home country soon" in q_lower:
        if re.search(r"adoption|adoption agenc|creating a family|adopt", profile_corpus, re.I):
            return "No; she's in the process of adopting children."

    return None


def answer_inference_question(
    memo: Memoryos,
    question: str,
    retrieval_results: Dict,
    answer_max_tokens: int,
    list_mode: bool,
) -> str:
    heuristic_answer = derive_inference_answer(question, retrieval_results)
    if heuristic_answer:
        return heuristic_answer

    profile_lines = collect_profile_evidence(question, retrieval_results, limit=14)
    if not profile_lines:
        profile_lines = collect_focused_evidence_snippets(question, retrieval_results, limit=10)
    if not profile_lines:
        return "Unknown"

    answer_shape = (
        "Return a concise comma-separated list."
        if list_mode
        else "Return a concise answer, using 'Likely yes', 'Likely no', or a short noun phrase when appropriate."
    )
    inference_prompt = (
        "You are doing conservative preference/persona inference from memory evidence.\n"
        "Infer the most likely answer only when the evidence shows a stable habit, trait, identity, preference, or long-term goal.\n"
        "If the evidence is too weak or contradictory, return 'Unknown'.\n"
        f"{answer_shape}\n\n"
        "Profile Evidence:\n"
        + "\n".join(f"- {line}" for line in profile_lines)
        + f"\n\nQuestion: {question}\nAnswer:"
    )
    answer = memo.client.chat_completion(
        model=memo.llm_model,
        messages=[{"role": "user", "content": inference_prompt}],
        temperature=0.0,
        max_tokens=answer_max_tokens,
    )
    return (answer or "").strip()


def select_top_citations(retrieval_results: Dict[str, Any], max_citations: int = 3) -> List[str]:
    citations: List[str] = []
    for page in retrieval_results.get("retrieved_pages", []) or []:
        citation_id = page.get("citation_id") or page.get("page_id") or page.get("id")
        if not citation_id or citation_id in citations:
            continue
        citations.append(str(citation_id))
        if len(citations) >= max_citations:
            break
    return citations


def answer_question(
    memo: Memoryos,
    question: str,
    max_results: int,
    token_budget: int,
    answer_max_tokens: int,
    evidence_pages: int,
    trace_base: Optional[Dict[str, Any]] = None,
) -> Tuple[str, Dict]:
    primary_trace_context = dict(trace_base or {})
    primary_trace_context.update({"query_kind": "primary", "query_text": question})
    retrieval_results = memo.retrieve_context(
        question,
        max_results=max_results,
        token_budget=token_budget,
        trace_context=primary_trace_context,
    )
    inference_mode = question_requires_inference(question)
    list_mode = question_expects_list(question)
    expanded_queries = build_expanded_queries(question)
    if inference_mode:
        expanded_queries.extend(
            [
                f"{' '.join(extract_question_names(question)) or 'person'} stable traits preferences identity goals habits values",
                f"{' '.join(extract_question_names(question)) or 'person'} likes enjoys supports wants career books outdoors family beliefs",
            ]
        )
    if expanded_queries:
        extra_results = [
            memo.retrieve_context(
                expanded_query,
                max_results=max_results,
                token_budget=token_budget,
                trace_context={
                    **dict(trace_base or {}),
                    "query_kind": "expanded",
                    "query_text": expanded_query,
                    "expanded_from": question,
                    "expanded_query_index": expanded_index,
                },
            )
            for expanded_index, expanded_query in enumerate(expanded_queries, start=1)
        ]
        retrieval_results = merge_retrieval_results(retrieval_results, extra_results)
    retrieval_results = rerank_retrieval_results(question, retrieval_results)
    retrieval_results["citations"] = select_top_citations(retrieval_results, max_citations=3)
    context_block = build_context_block(question, retrieval_results, max_pages=evidence_pages)
    if inference_mode:
        answer = answer_inference_question(
            memo,
            question,
            retrieval_results,
            answer_max_tokens=answer_max_tokens,
            list_mode=list_mode,
        )
    else:
        prompt = build_answer_prompt(question, context_block, inference_mode=False, list_mode=list_mode)
        answer = memo.client.chat_completion(
            model=memo.llm_model,
            messages=[{"role": "user", "content": prompt}],
            temperature=0.0,
            max_tokens=answer_max_tokens,
        )
        answer = (answer or "").strip()
    if normalize_text(answer) == "unknown" and has_actionable_evidence(question, retrieval_results):
        retry_answer = retry_unknown_answer(
            memo,
            question,
            retrieval_results,
            answer_max_tokens=answer_max_tokens,
            inference_mode=inference_mode,
            list_mode=list_mode,
        )
        if retry_answer:
            answer = retry_answer
    answer = postprocess_temporal_answer(question, (answer or "").strip(), retrieval_results)
    return answer, retrieval_results


def evaluate_sample(
    sample: Dict,
    sample_position: int,
    args: argparse.Namespace,
    ollama_host: str,
) -> Dict:
    unique_user_id = f"locomo_{sample.get('sample_id', sample_position)}_{int(time.time())}"
    trace_recorder = None
    trace_path = ""
    if args.trace_output:
        trace_path = str(resolve_trace_output_path(args.trace_output, sample, sample_position))
        trace_recorder = TraceRecorder(
            trace_path,
            run_metadata={
                "benchmark": "locomo",
                "sample_id": sample.get("sample_id"),
                "sample_position": sample_position,
                "dataset": "locomo",
            },
        )
    memo = Memoryos(
        user_id=unique_user_id,
        openai_api_key="ollama",
        openai_base_url=f"{ollama_host}/v1",
        data_storage_path=args.storage_root,
        llm_model=args.llm_model,
        embedding_model_name=args.embedding_model,
        short_term_capacity=args.short_term_capacity,
        long_term_knowledge_capacity=args.long_term_capacity,
        retrieval_queue_capacity=args.retrieval_queue_capacity,
        trace_recorder=trace_recorder,
    )

    ingested_memory_count = 0
    records = []
    try:
        for session_id in iter_session_ids(sample["conversation"]):
            for memory_entry in build_locomo_memory_entries(sample, session_id, args):
                memo.add_memory(
                    user_input=memory_entry["user_input"],
                    agent_response=memory_entry["agent_response"],
                    meta_data=memory_entry.get("metadata"),
                )
                ingested_memory_count += 1

        questions = sample.get("qa", [])
        if args.question_limit > 0:
            questions = questions[: args.question_limit]

        em_scores = []
        f1_scores = []

        print(
            f"\n[Sample {sample_position}] {sample.get('sample_id')} | "
            f"sessions={len(iter_session_ids(sample['conversation']))} | memories={ingested_memory_count} | questions={len(questions)}"
        )

        for index, qa in enumerate(questions, start=1):
            question = str(qa.get("question", "")).strip()
            gold_answer = get_gold_answer(qa)
            trace_context = {
                "sample_id": sample.get("sample_id"),
                "sample_position": sample_position,
                "question_index": index,
                "question_category": qa.get("category"),
            }
            memo.client.clear_usage_history()
            memory_utils.clear_embedding_usage_history()
            start_time = time.perf_counter()
            prediction, retrieval_results = answer_question(
                memo,
                question,
                max_results=args.max_results,
                token_budget=args.token_budget,
                answer_max_tokens=args.answer_max_tokens,
                evidence_pages=args.evidence_pages,
                trace_base=trace_context,
            )
            latency = time.perf_counter() - start_time
            retrieval_token_usage = memory_utils.summarize_usage_events(memory_utils.snapshot_embedding_usage_history())
            reasoning_token_usage = memory_utils.summarize_usage_events(memo.client.snapshot_usage_history())
            recall_at_1 = compute_recall_at_k(qa.get("evidence", []), retrieval_results.get("retrieved_pages", []) or [], 1)
            recall_at_10 = compute_recall_at_k(qa.get("evidence", []), retrieval_results.get("retrieved_pages", []) or [], 10)
            em = exact_match(prediction, gold_answer)
            f1 = token_f1(prediction, gold_answer)
            em_scores.append(em)
            f1_scores.append(f1)
            page_lookup = _page_lookup(retrieval_results.get("retrieved_pages", []) or [])
            citations = [
                citation_id
                for citation_id in (retrieval_results.get("citations", []) or [])
                if str(citation_id) in page_lookup
            ]
            hit_ids = retrieval_results.get("hit_ids", [])
            salvage_count = int(retrieval_results.get("salvage_count", 0) or 0)
            citation_preview = memo.lifecycle.preview_nli_citations(
                prediction,
                citations,
                max_citations=max(1, len(citations)),
            )
            evaluation = build_evaluation_result(
                gold_answer=gold_answer,
                predicted_answer=prediction,
                gold_evidence_ids=qa.get("evidence", []),
                predicted_evidence_ids=get_locomo_predicted_evidence_ids(citations, retrieval_results.get("retrieved_pages", []) or []),
                citation_support_precision=support_precision_from_nli_preview(citation_preview),
                citation_ids=citations,
                hit_ids=hit_ids,
                answer_em=em,
                answer_f1=f1,
            )
            if trace_recorder is not None:
                trace_recorder.record_question_event(
                    {
                        "trace_context": dict(trace_context),
                        "sample_id": sample.get("sample_id"),
                        "question_index": index,
                        "question": question,
                        "gold_answer": gold_answer,
                        "prediction": prediction,
                        "latency_sec": round(latency, 3),
                        "citations": citations,
                        "hit_ids": hit_ids,
                        "memory_ids": list(dict.fromkeys(hit_ids + citations)),
                        "salvage_count": salvage_count,
                        "source_stats": dict(retrieval_results.get("source_stats", {})),
                        "recall_at_1": recall_at_1,
                        "recall_at_10": recall_at_10,
                        "retrieval_token_usage": dict(retrieval_token_usage),
                        "reasoning_token_usage": dict(reasoning_token_usage),
                        "scores": dict(evaluation.get("scores", {})),
                    }
                )
            if retrieval_results.get("hit_ids"):
                memo.lifecycle.schedule_nli_verify_citations(
                    prediction,
                    retrieval_results.get("hit_ids", [])[:3],
                    trace_context={**trace_context, "query_kind": "top_hit_nli"},
                )

            record = {
                "sample_id": sample.get("sample_id"),
                "question_index": index,
                "question": question,
                "gold_answer": gold_answer,
                "prediction": prediction,
                "category": qa.get("category"),
                "evidence": qa.get("evidence", []),
                "citations": citations,
                "hit_ids": hit_ids,
                "salvage_count": salvage_count,
                "source_stats": retrieval_results.get("source_stats", {}),
                "em": evaluation["scores"]["answer_em"],
                "f1": evaluation["scores"]["answer_f1"],
                "recall_at_1": recall_at_1,
                "recall_at_10": recall_at_10,
                "retrieval_token_usage": retrieval_token_usage,
                "reasoning_token_usage": reasoning_token_usage,
                "latency_sec": round(latency, 3),
                "citation_preview": citation_preview,
                "gold": evaluation["gold"],
                "pred": evaluation["pred"],
                "scores": evaluation["scores"],
            }
            records.append(record)

            print(
                f"  [{index:03d}] EM={em:.0f} F1={f1:.2f} R@1={recall_at_1:.2f} R@10={recall_at_10:.2f} "
                f"latency={latency:.2f}s question={question[:70]}"
            )
    finally:
        memo.shutdown(wait_for_background_tasks=False)

    if trace_recorder is not None:
        trace_recorder.update_run_metadata(
            user_id=unique_user_id,
            question_count=len(records),
            ingested_memory_count=ingested_memory_count,
        )
        trace_path = trace_recorder.finalize(
            extra={
                "sample_id": sample.get("sample_id"),
                "sample_position": sample_position,
                "question_count": len(records),
                "ingested_memory_count": ingested_memory_count,
            }
        )

    score_summary = summarize_score_metrics(records)
    salvage_summary = summarize_salvage_metrics(records)
    runtime_summary = summarize_runtime_metrics(records)
    return {
        "sample_id": sample.get("sample_id"),
        "user_id": unique_user_id,
        "question_count": len(records),
        "em": score_summary["answer_em"],
        "f1": score_summary["answer_f1"],
        "recall_at_1": runtime_summary["recall_at_1"],
        "recall_at_10": runtime_summary["recall_at_10"],
        "latency_sec": runtime_summary["latency_sec"],
        "retrieval_token_usage": runtime_summary["retrieval_token_usage"],
        "reasoning_token_usage": runtime_summary["reasoning_token_usage"],
        "answer_score": score_summary["answer_score"],
        "citation_score": score_summary["citation_score"],
        "final": score_summary["final"],
        **salvage_summary,
        "records": records,
        "trace_path": trace_path,
    }


def resolve_trace_output_path(trace_output: str, sample: Dict, sample_position: int) -> Path:
    target = Path(trace_output).expanduser()
    sample_label = str(sample.get("sample_id", sample_position)).replace("/", "_")
    if not target.suffix:
        return target / f"locomo_trace_{sample_label}.json"
    return target


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run the real LoCoMo benchmark with an isolated Ollama server.")
    parser.add_argument("--dataset", default=str(find_default_dataset_path()))
    parser.add_argument("--sample-index", type=int, default=0)
    parser.add_argument("--sample-limit", type=int, default=1, help="0 means run all samples from sample-index.")
    parser.add_argument("--question-limit", type=int, default=0, help="0 means run all questions for each sample.")
    parser.add_argument("--gpu-devices", default=os.environ.get("CUDA_VISIBLE_DEVICES", "0,1,2,3"))
    parser.add_argument("--ollama-port", type=int, default=11534)
    parser.add_argument("--llm-model", default="qwen2.5:7b")
    parser.add_argument("--embedding-model", default="nomic-embed-text")
    parser.add_argument("--models-dir", default=os.environ.get("OLLAMA_MODELS"))
    parser.add_argument("--storage-root", default=str(PROJECT_ROOT / "eval_storage"))
    parser.add_argument("--report-path", default="")
    parser.add_argument("--keep-ollama", action="store_true")
    parser.add_argument("--max-results", type=int, default=8)
    parser.add_argument("--evidence-pages", type=int, default=6)
    parser.add_argument("--token-budget", type=int, default=2600)
    parser.add_argument("--answer-max-tokens", type=int, default=128)
    parser.add_argument("--short-term-capacity", type=int, default=12)
    parser.add_argument("--long-term-capacity", type=int, default=5000)
    parser.add_argument("--retrieval-queue-capacity", type=int, default=30)
    parser.add_argument("--session-transcript-max-chars", type=int, default=2400)
    parser.add_argument("--turn-window-size", type=int, default=12)
    parser.add_argument("--turn-window-overlap", type=int, default=3)
    parser.add_argument("--turn-window-max-chars", type=int, default=1800)
    parser.add_argument("--trace-output", default="", help="Optional JSON path or directory for a per-sample trace dump.")
    return parser.parse_args()


def slice_samples(dataset: List[Dict], sample_index: int, sample_limit: int) -> List[Dict]:
    if sample_index < 0 or sample_index >= len(dataset):
        raise IndexError(f"sample-index {sample_index} out of range for dataset of size {len(dataset)}")
    subset = dataset[sample_index:]
    if sample_limit > 0:
        subset = subset[:sample_limit]
    return subset


def main() -> None:
    args = parse_args()
    dataset_path = Path(args.dataset).resolve()
    dataset = load_dataset(dataset_path)
    samples = slice_samples(dataset, args.sample_index, args.sample_limit)

    args.storage_root = str(Path(args.storage_root).resolve())
    Path(args.storage_root).mkdir(parents=True, exist_ok=True)

    selected_port = choose_port(args.ollama_port)
    ollama_server = start_isolated_ollama(
        port=selected_port,
        gpu_devices=args.gpu_devices,
        keep_running=args.keep_ollama,
        models_dir=args.models_dir,
    )

    memory_utils.OLLAMA_HOST = ollama_server.host

    print("==================================================================")
    print("LoCoMo Benchmark")
    print("==================================================================")
    print(f"Dataset: {dataset_path}")
    print(f"Samples: {len(samples)} (from index {args.sample_index})")
    print(f"Question limit: {'all' if args.question_limit == 0 else args.question_limit}")
    print(f"Isolated Ollama: {ollama_server.host}")
    print(f"CUDA_VISIBLE_DEVICES: {args.gpu_devices}")
    print(f"Ollama log: {ollama_server.log_path}")

    all_results = []
    for offset, sample in enumerate(samples, start=args.sample_index):
        all_results.append(
            evaluate_sample(
                sample=sample,
                sample_position=offset,
                args=args,
                ollama_host=ollama_server.host,
            )
        )

    all_records = [record for result in all_results for record in result["records"]]
    score_summary = summarize_score_metrics(all_records)
    salvage_summary = summarize_salvage_metrics(all_records)
    runtime_summary = summarize_runtime_metrics(all_records)
    final_report = {
        "dataset": str(dataset_path),
        "sample_index": args.sample_index,
        "sample_limit": args.sample_limit,
        "question_limit": args.question_limit,
        "gpu_devices": args.gpu_devices,
        "ollama_host": ollama_server.host,
        "llm_model": args.llm_model,
        "embedding_model": args.embedding_model,
        "sample_results": [
            {
                "sample_id": result["sample_id"],
                "user_id": result["user_id"],
                "question_count": result["question_count"],
                "em": result["em"],
                "f1": result["f1"],
                "recall_at_1": result["recall_at_1"],
                "recall_at_10": result["recall_at_10"],
                "latency_sec": result["latency_sec"],
                "retrieval_token_usage": result["retrieval_token_usage"],
                "reasoning_token_usage": result["reasoning_token_usage"],
                "answer_score": result["answer_score"],
                "citation_score": result["citation_score"],
                "final": result["final"],
                "forget_pool_salvage_count": result["forget_pool_salvage_count"],
                "questions_with_forget_pool_salvage": result["questions_with_forget_pool_salvage"],
                "forget_pool_salvage_rate": result["forget_pool_salvage_rate"],
                "avg_forget_pool_salvage_count": result["avg_forget_pool_salvage_count"],
                "trace_path": result.get("trace_path", ""),
            }
            for result in all_results
        ],
        "overall": {
            "question_count": len(all_records),
            "em": score_summary["answer_em"],
            "f1": score_summary["answer_f1"],
            **runtime_summary,
            **score_summary,
            **salvage_summary,
        },
        "records": all_records,
    }

    report_path = Path(args.report_path).resolve() if args.report_path else (
        PROJECT_ROOT / f"locomo_report_{int(time.time())}.json"
    )
    with report_path.open("w", encoding="utf-8") as handle:
        json.dump(final_report, handle, ensure_ascii=False, indent=2)

    print("\n==================================================================")
    print("LoCoMo Summary")
    print("==================================================================")
    print(f"Questions: {final_report['overall']['question_count']}")
    print(f"EM: {final_report['overall']['em']:.4f}")
    print(f"F1: {final_report['overall']['f1']:.4f}")
    print(f"Recall@1: {final_report['overall']['recall_at_1']:.4f}")
    print(f"Recall@10: {final_report['overall']['recall_at_10']:.4f}")
    print(f"Avg Latency: {final_report['overall']['latency_sec']:.4f}s")
    print(
        "Avg Retrieval Tokens: "
        f"{final_report['overall']['retrieval_token_usage']['avg_total_tokens']:.4f} "
        f"(calls={final_report['overall']['retrieval_token_usage']['avg_calls']:.4f})"
    )
    print(
        "Avg Reasoning Tokens: "
        f"{final_report['overall']['reasoning_token_usage']['avg_total_tokens']:.4f} "
        f"(prompt={final_report['overall']['reasoning_token_usage']['avg_prompt_tokens']:.4f}, "
        f"completion={final_report['overall']['reasoning_token_usage']['avg_completion_tokens']:.4f})"
    )
    print(
        "Forget-Pool Salvage: "
        f"{final_report['overall']['forget_pool_salvage_count']} hits across "
        f"{final_report['overall']['questions_with_forget_pool_salvage']} questions "
        f"(rate={final_report['overall']['forget_pool_salvage_rate']:.4f})"
    )
    print(f"Report: {report_path}")
    trace_paths = [result.get("trace_path") for result in all_results if result.get("trace_path")]
    if trace_paths:
        print(f"Trace: {trace_paths[0] if len(trace_paths) == 1 else ', '.join(trace_paths)}")

    if not args.keep_ollama:
        ollama_server.stop()


if __name__ == "__main__":
    main()
