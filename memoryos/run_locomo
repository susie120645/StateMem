DIALOGUE_ID_PATTERN = re.compile(r"\bD\d+:\d+\b")


def extract_temporal_canonical_forms(text: object) -> List[str]:
    cleaned = strip_ordinal_suffixes(str(text or ""))
    lowered = cleaned.lower()
    forms = set()

    for match in re.finditer(r"\b(\d{1,2})\s+([A-Za-z]+)\s*,?\s*(\d{4})\b", cleaned):
        month_num = MONTH_NAME_TO_NUMBER.get(match.group(2).lower())
        if not month_num:
            continue
        day = int(match.group(1))
        year = int(match.group(3))
        try:
            dt = datetime(year, month_num, day)
        except ValueError:
            continue
        forms.add(f"date:{dt.strftime('%Y-%m-%d')}")
        forms.add(f"year:{year}")
        forms.add(f"month:{dt.strftime('%Y-%m')}")

    for match in re.finditer(r"\b(?:since about|start year|year|in)\s+(\d{4})\b", lowered):
        forms.add(f"year:{match.group(1)}")

    if not forms:
        years = re.findall(r"\b(19\d{2}|20\d{2}|21\d{2})\b", lowered)
        if len(set(years)) == 1:
            forms.add(f"year:{years[0]}")

    for match in re.finditer(r"\b(?:a|one)\s+week\s+before\s+(\d{1,2}\s+[A-Za-z]+\s*,?\s*\d{4})\b", cleaned, re.I):
        ref_forms = extract_temporal_canonical_forms(match.group(1))
        ref_date = next((item for item in ref_forms if item.startswith("date:")), None)
        if ref_date:
            ref_dt = datetime.strptime(ref_date.split(":", 1)[1], "%Y-%m-%d")
            anchor = ref_dt - timedelta(days=7)
            forms.add(f"week_of:{anchor.strftime('%Y-%m-%d')}")

    for match in re.finditer(r"\bweek of (\d{1,2}\s+[A-Za-z]+\s*,?\s*\d{4})\b", cleaned, re.I):
        ref_forms = extract_temporal_canonical_forms(match.group(1))
        ref_date = next((item for item in ref_forms if item.startswith("date:")), None)
        if ref_date:
            ref_dt = datetime.strptime(ref_date.split(":", 1)[1], "%Y-%m-%d")
            forms.add(f"week_of:{ref_dt.strftime('%Y-%m-%d')}")

    for match in re.finditer(r"\blast week of ([A-Za-z]+)\s+(\d{4})\b", lowered):
        month_num = MONTH_NAME_TO_NUMBER.get(match.group(1).lower())
        if month_num:
            forms.add(f"last_week_month:{match.group(2)}-{month_num:02d}")

    for match in re.finditer(
        r"\b(?:for\s+)?(?:about |around |almost )?(\d+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve)\s+years?\b",
        lowered,
    ):
        value = parse_number_token(match.group(1))
        if value is not None:
            forms.add(f"duration_years:{value}")

    return sorted(forms)


def temporal_answers_equivalent(prediction: object, answer: object) -> bool:
    pred_forms = set(extract_temporal_canonical_forms(prediction))
    gold_forms = set(extract_temporal_canonical_forms(answer))
    if not pred_forms or not gold_forms:
        return False
    return bool(pred_forms & gold_forms)


def exact_match(prediction: object, answer: object) -> float:
    if normalize_text(prediction) == normalize_text(answer):
        return 1.0
    return 1.0 if temporal_answers_equivalent(prediction, answer) else 0.0


def token_f1(prediction: object, answer: object) -> float:
    if temporal_answers_equivalent(prediction, answer):
        return 1.0
    pred_tokens = normalize_text(prediction).split()
    gold_tokens = normalize_text(answer).split()
    if not pred_tokens and not gold_tokens:
        return 1.0
    if not pred_tokens or not gold_tokens:
        return 0.0

    pred_counts: Dict[str, int] = {}
    gold_counts: Dict[str, int] = {}
    for token in pred_tokens:
        pred_counts[token] = pred_counts.get(token, 0) + 1
    for token in gold_tokens:
        gold_counts[token] = gold_counts.get(token, 0) + 1

    overlap = 0
    for token, count in pred_counts.items():
        overlap += min(count, gold_counts.get(token, 0))
    if overlap == 0:
        return 0.0

    precision = overlap / len(pred_tokens)
    recall = overlap / len(gold_tokens)
    return 2 * precision * recall / (precision + recall)


def _page_lookup(pages: List[Dict[str, Any]]) -> Dict[str, Dict[str, Any]]:
    lookup: Dict[str, Dict[str, Any]] = {}
    for page in pages or []:
        citation_id = page.get("citation_id") or page.get("page_id")
        if citation_id:
            lookup[str(citation_id)] = page
    return lookup


def _page_metadata(page: Dict[str, Any]) -> Dict[str, Any]:
    metadata = page.get("metadata", {})
    if isinstance(metadata, dict):
        return metadata
    legacy_metadata = page.get("meta_data", {})
    return legacy_metadata if isinstance(legacy_metadata, dict) else {}


def extract_locomo_evidence_ids_from_page(page: Dict[str, Any]) -> List[str]:
    metadata = _page_metadata(page or {})
    window_dia_ids = metadata.get("window_dia_ids", [])
    if isinstance(window_dia_ids, list) and window_dia_ids:
        return [str(dia_id).strip() for dia_id in window_dia_ids if str(dia_id).strip()]
    text = "\n".join(
        [
            str(page.get("raw_content", "")),
            str(page.get("agent_response", "")),
            str(page.get("summary", "")),
        ]
    )
    return DIALOGUE_ID_PATTERN.findall(text)


def get_locomo_predicted_evidence_ids(citations: List[str], pages: List[Dict[str, Any]]) -> List[str]:
    evidence_ids: List[str] = []
    page_lookup = _page_lookup(pages)
    for citation_id in citations or []:
        evidence_ids.extend(extract_locomo_evidence_ids_from_page(page_lookup.get(str(citation_id), {})))
    return evidence_ids


def normalize_locomo_evidence_id(value: Any) -> str:
    return re.sub(r"\s+", "", str(value or "").strip().lower())


def get_locomo_retrieved_evidence_ids(pages: List[Dict[str, Any]], top_k: int) -> List[str]:
    evidence_ids: List[str] = []
    seen = set()
    for page in (pages or [])[: max(0, int(top_k))]:
        for evidence_id in extract_locomo_evidence_ids_from_page(page):
            normalized = normalize_locomo_evidence_id(evidence_id)
            if not normalized or normalized in seen:
                continue
            seen.add(normalized)
            evidence_ids.append(str(evidence_id).strip())
    return evidence_ids


def compute_recall_at_k(gold_evidence_ids: List[str], pages: List[Dict[str, Any]], top_k: int) -> float:
    gold = {
        normalize_locomo_evidence_id(evidence_id)
        for evidence_id in (gold_evidence_ids or [])
        if normalize_locomo_evidence_id(evidence_id)
    }
    if not gold:
        return 1.0

    retrieved = {
        normalize_locomo_evidence_id(evidence_id)
        for evidence_id in get_locomo_retrieved_evidence_ids(pages, top_k)
        if normalize_locomo_evidence_id(evidence_id)
    }
    if not retrieved:
        return 0.0
    return round(len(gold & retrieved) / float(len(gold)), 4)


def summarize_token_usage(records: List[Dict[str, Any]], field_name: str) -> Dict[str, float]:
    totals = {
        "calls": 0,
        "prompt_tokens": 0,
        "completion_tokens": 0,
        "total_tokens": 0,
    }
    count = len(records)
    for record in records:
        usage = record.get(field_name, {}) if isinstance(record, dict) else {}
        if not isinstance(usage, dict):
            continue
        for key in totals:
            value = usage.get(key, 0)
            if isinstance(value, (int, float)):
                totals[key] += float(value)
    summary: Dict[str, float] = {}
    for key, value in totals.items():
        if key == "calls":
            summary[f"total_{key}"] = int(value)
        else:
            summary[f"total_{key}"] = int(round(value))
        summary[f"avg_{key}"] = round(value / count, 4) if count else 0.0
    return summary


def summarize_runtime_metrics(records: List[Dict[str, Any]]) -> Dict[str, Any]:
    if not records:
        return {
            "latency_sec": 0.0,
            "recall_at_1": 0.0,
            "recall_at_10": 0.0,
            "retrieval_token_usage": summarize_token_usage([], "retrieval_token_usage"),
            "reasoning_token_usage": summarize_token_usage([], "reasoning_token_usage"),
        }
    return {
        "latency_sec": round(mean([float(record.get("latency_sec", 0.0) or 0.0) for record in records]), 4),
        "recall_at_1": round(mean([float(record.get("recall_at_1", 0.0) or 0.0) for record in records]), 4),
        "recall_at_10": round(mean([float(record.get("recall_at_10", 0.0) or 0.0) for record in records]), 4),
        "retrieval_token_usage": summarize_token_usage(records, "retrieval_token_usage"),
        "reasoning_token_usage": summarize_token_usage(records, "reasoning_token_usage"),
    }


def port_is_free(port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.bind(("127.0.0.1", port))
        except OSError:
            return False
    return True


def choose_port(preferred_port: int) -> int:
    port = preferred_port
    while not port_is_free(port):
        port += 1
    return port


class OllamaServer:
    def __init__(self, host: str, process: subprocess.Popen, log_path: Path, keep_running: bool = False):
        self.host = host.rstrip("/")
        self.process = process
        self.log_path = log_path
        self.keep_running = keep_running

    def stop(self) -> None:
        if self.keep_running or self.process.poll() is not None:
            return
        self.process.terminate()
        try:
            self.process.wait(timeout=10)
        except subprocess.TimeoutExpired:
            self.process.kill()
            self.process.wait(timeout=5)


def start_isolated_ollama(
    port: int,
    gpu_devices: str,
    keep_running: bool,
    models_dir: Optional[str] = None,
) -> OllamaServer:
    host = f"http://127.0.0.1:{port}"
    log_path = PROJECT_ROOT / f"ollama_locomo_{port}.log"
    env = os.environ.copy()
    env["CUDA_VISIBLE_DEVICES"] = gpu_devices
    env["OLLAMA_HOST"] = host
    env.setdefault("OLLAMA_NUM_PARALLEL", "1")
    env.setdefault("OLLAMA_KEEP_ALIVE", "30m")
    env.setdefault("OLLAMA_LLM_LIBRARY", os.environ.get("OLLAMA_LLM_LIBRARY", "cuda_v12"))
    for proxy_key in ("NO_PROXY", "no_proxy"):
        current = env.get(proxy_key, "")
        values = [item.strip() for item in current.split(",") if item.strip()]
        for host_value in ("127.0.0.1", "localhost"):
            if host_value not in values:
                values.append(host_value)
        env[proxy_key] = ",".join(values)
    if models_dir:
        env["OLLAMA_MODELS"] = models_dir

    log_file = open(log_path, "w", encoding="utf-8")
    process = subprocess.Popen(
        ["ollama", "serve"],
        stdout=log_file,
        stderr=log_file,
        env=env,
        cwd=str(PROJECT_ROOT),
    )

    session = requests.Session()
    session.trust_env = False
    deadline = time.time() + 90
    while time.time() < deadline:
        if process.poll() is not None:
            raise RuntimeError(
                f"Independent Ollama exited early. Check log: {log_path}"
            )
        try:
            response = session.get(f"{host}/api/tags", timeout=2)
            if response.ok:
                server = OllamaServer(host=host, process=process, log_path=log_path, keep_running=keep_running)
                atexit.register(server.stop)
                return server
        except requests.RequestException:
            pass
        time.sleep(1)

    process.terminate()
    raise RuntimeError(f"Timed out waiting for Ollama on {host}. Check log: {log_path}")


def find_default_dataset_path() -> Path:
    candidates = [
        REPO_ROOT / "eval" / "locomo10.json",
        PROJECT_ROOT / "eval" / "locomo10.json",
        PROJECT_ROOT / "data" / "locomo10.json",
    ]
    for candidate in candidates:
        if candidate.exists():
            return candidate
    return candidates[0]


def load_dataset(dataset_path: Path) -> List[Dict]:
    with dataset_path.open("r", encoding="utf-8") as handle:
        dataset = json.load(handle)
    if not isinstance(dataset, list) or not dataset:
        raise ValueError(f"Invalid LoCoMo dataset: {dataset_path}")
    return dataset


def iter_session_ids(conversation: Dict) -> List[int]:
    session_ids = []
    for key in conversation:
        match = re.fullmatch(r"session_(\d+)", key)
        if match:
            session_ids.append(int(match.group(1)))
    return sorted(session_ids)


