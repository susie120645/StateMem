WEEKDAY_TO_INDEX = {
    "monday": 0,
    "tuesday": 1,
    "wednesday": 2,
    "thursday": 3,
    "friday": 4,
    "saturday": 5,
    "sunday": 6,
}


def strip_ordinal_suffixes(text: str) -> str:
    return re.sub(r"(\d{1,2})(st|nd|rd|th)\b", r"\1", text or "", flags=re.I)


def parse_session_datetime(date_time: str) -> Optional[datetime]:
    cleaned = strip_ordinal_suffixes(str(date_time or ""))
    cleaned = re.sub(r"\s+", " ", cleaned.replace(" ,", ",")).strip()
    formats = [
        "%I:%M %p on %d %B, %Y",
        "%I:%M %p on %d %B %Y",
        "%I:%M %p on %B %d, %Y",
        "%I:%M %p on %B %d %Y",
        "%I:%M %p, %d %B, %Y",
        "%I:%M %p, %d %B %Y",
    ]
    for fmt in formats:
        try:
            return datetime.strptime(cleaned, fmt)
        except ValueError:
            continue
    return None


def format_exact_date(value: datetime) -> str:
    return value.strftime("%-d %B %Y")


def format_month_year(value: datetime) -> str:
    return value.strftime("%B %Y")


def shift_months(value: datetime, months: int) -> datetime:
    year = value.year + ((value.month - 1 + months) // 12)
    month = ((value.month - 1 + months) % 12) + 1
    day = min(value.day, 28)
    return value.replace(year=year, month=month, day=day)


def parse_number_token(token: str) -> Optional[int]:
    token = str(token or "").strip().lower()
    if not token:
        return None
    if token.isdigit():
        return int(token)
    return NUMBER_WORDS.get(token)


def resolve_weekday(anchor: datetime, weekday_name: str, direction: int) -> Optional[datetime]:
    weekday_index = WEEKDAY_TO_INDEX.get(weekday_name.lower())
    if weekday_index is None:
        return None
    current = anchor.weekday()
    if direction < 0:
        delta = (current - weekday_index) % 7 or 7
        return anchor - timedelta(days=delta)
    delta = (weekday_index - current) % 7 or 7
    return anchor + timedelta(days=delta)


def resolve_relative_time_expressions(text: str, anchor: Optional[datetime]) -> List[str]:
    if not text or anchor is None:
        return []

    lowered = str(text).lower()
    resolutions: List[str] = []

    def add_resolution(label: str, value: str) -> None:
        candidate = f"{label} -> {value}"
        if candidate not in resolutions:
            resolutions.append(candidate)

    if re.search(r"\byesterday\b", lowered):
        add_resolution("yesterday", format_exact_date(anchor - timedelta(days=1)))
    if re.search(r"\btoday\b", lowered):
        add_resolution("today", format_exact_date(anchor))
    if re.search(r"\btomorrow\b", lowered):
        add_resolution("tomorrow", format_exact_date(anchor + timedelta(days=1)))
    if re.search(r"\blast month\b|\bprevious month\b", lowered):
        add_resolution("last month", format_month_year(shift_months(anchor, -1)))
    if re.search(r"\bnext month\b", lowered):
        add_resolution("next month", format_month_year(shift_months(anchor, 1)))
    if re.search(r"\blast year\b|\bprevious year\b", lowered):
        add_resolution("last year", str(anchor.year - 1))
    if re.search(r"\bnext year\b", lowered):
        add_resolution("next year", str(anchor.year + 1))
    if re.search(r"\blast week\b|\bprevious week\b", lowered):
        start = anchor - timedelta(days=7)
        add_resolution("last week", f"week of {format_exact_date(start)}")
    if re.search(r"\bnext week\b", lowered):
        start = anchor + timedelta(days=7)
        add_resolution("next week", f"week of {format_exact_date(start)}")

    for match in re.finditer(r"\b(last|next|previous)\s+(monday|tuesday|wednesday|thursday|friday|saturday|sunday)\b", lowered):
        direction = -1 if match.group(1) in {"last", "previous"} else 1
        resolved = resolve_weekday(anchor, match.group(2), direction)
        if resolved is not None:
            add_resolution(match.group(0), format_exact_date(resolved))

    for match in re.finditer(r"\bon the (\d{1,2})(st|nd|rd|th)?\b", lowered):
        day = int(match.group(1))
        try:
            resolved = anchor.replace(day=day)
        except ValueError:
            continue
        add_resolution(match.group(0), format_exact_date(resolved))

    for match in re.finditer(r"\b(\d+|a|an|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve)\s+years?\s+ago\b", lowered):
        years = parse_number_token(match.group(1))
        if years is None:
            continue
        try:
            resolved = anchor.replace(year=anchor.year - years)
            add_resolution(match.group(0), f"around {format_exact_date(resolved)} (year {resolved.year})")
        except ValueError:
            add_resolution(match.group(0), f"around {anchor.year - years}")

    for match in re.finditer(r"\bfor (?:about |around |almost )?(\d+|a|an|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve)\s+years?(?: now)?\b", lowered):
        years = parse_number_token(match.group(1))
        if years is None:
            continue
        start_year = anchor.year - years
        add_resolution(match.group(0), f"since about {start_year} (start year {start_year})")

    return resolutions[:4]


def annotate_text_with_time_resolution(text: str, anchor: Optional[datetime]) -> str:
    text = str(text or "")
    resolutions = resolve_relative_time_expressions(text, anchor)
    if not resolutions:
        return text
    return f"{text} [Resolved Time: {'; '.join(resolutions)}]"


def find_best_matching_evidence_line(question: str, retrieval_results: Dict) -> str:
    question_terms = extract_question_terms(question)
    temporal = question_is_temporal(question)
    best_line = ""
    best_score = float("-inf")
    for page in retrieval_results.get("retrieved_pages", []):
        raw_text = page.get("raw_content") or page.get("agent_response", "")
        for line in str(raw_text).splitlines():
            score = score_evidence_line(question, line, question_terms=question_terms, temporal=temporal)
            if score > best_score:
                best_score = score
                best_line = line.strip()
    return best_line


def collect_relevant_evidence_lines(question: str, retrieval_results: Dict, limit: int = 12) -> List[str]:
    question_terms = extract_question_terms(question)
    temporal = question_is_temporal(question)
    scored: List[Tuple[float, str]] = []
    for page in retrieval_results.get("retrieved_pages", []):
        raw_text = page.get("raw_content") or page.get("agent_response", "")
        for line in str(raw_text).splitlines():
            stripped = line.strip()
            if not stripped:
                continue
            score = score_evidence_line(question, stripped, question_terms=question_terms, temporal=temporal)
            if score > 0:
                scored.append((score, stripped))
    scored.sort(key=lambda item: item[0], reverse=True)
    result: List[str] = []
    for _, line in scored:
        if line not in result:
            result.append(line)
        if len(result) >= limit:
            break
    return result


def collect_retrieval_corpus(retrieval_results: Dict) -> str:
    chunks: List[str] = []
    for page in retrieval_results.get("retrieved_pages", []):
        raw_text = page.get("raw_content") or page.get("agent_response", "")
        if raw_text:
            chunks.append(str(raw_text))
    return "\n".join(chunks)


def extract_question_names(question: str) -> List[str]:
    ignore = {"What", "When", "Where", "Which", "How", "Does", "Did", "Is", "Are"}
    names: List[str] = []
    for token in re.findall(r"\b[A-Z][a-z]+\b", question):
        if token in ignore or token in names:
            continue
        if token == "Deb":
            token = "Deborah"
        names.append(token)
    return names


def extract_question_terms(question: str) -> set:
    return {
        token
        for token in re.findall(r"[a-z0-9]+", question.lower())
        if token not in QUESTION_STOP_WORDS
    }


def question_is_temporal(question: str) -> bool:
    q_lower = question.lower().strip()
    return q_lower.startswith("when") or "what date" in q_lower or q_lower.startswith("which year") or q_lower.startswith("how long")


def extract_question_phrases(question: str) -> List[str]:
    tokens = [token for token in re.findall(r"[a-z0-9]+", question.lower()) if token not in QUESTION_STOP_WORDS]
    phrases: List[str] = []
    for size in (3, 2):
        for index in range(0, max(0, len(tokens) - size + 1)):
            phrase = " ".join(tokens[index : index + size])
            if len(phrase) < 6:
                continue
            if phrase not in phrases:
                phrases.append(phrase)
    return phrases[:8]


def score_evidence_line(
    question: str,
    line: str,
    question_terms: Optional[set] = None,
    temporal: Optional[bool] = None,
) -> float:
    question_terms = question_terms if question_terms is not None else extract_question_terms(question)
    temporal = temporal if temporal is not None else question_is_temporal(question)
    line_lower = str(line or "").lower()
    line_terms = set(re.findall(r"[a-z0-9]+", line_lower))
    overlap = len(question_terms & line_terms)
    score = float(overlap)

    for name in extract_question_names(question):
        if name.lower() in line_lower:
            score += 1.2

    for phrase in extract_question_phrases(question):
        if phrase in line_lower:
            score += 1.6 if len(phrase.split()) >= 3 else 1.0

    if temporal:
        if "exact time:" in line_lower:
            score += 4.0
        if "resolved time:" in line_lower:
            score += 2.5
        if "date:" in line_lower:
            score += 1.8
        if re.search(r"\b\d{1,2}\s+[a-z]+,?\s+\d{4}\b", line_lower):
            score += 3.2
        if "yesterday ->" in line_lower or "today ->" in line_lower or "tomorrow ->" in line_lower:
            score += 2.2

    return score


