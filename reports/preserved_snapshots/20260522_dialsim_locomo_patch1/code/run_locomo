def slice_samples(dataset: List[Dict], sample_index: int, sample_limit: int) -> List[Dict]:
    if sample_index < 0 or sample_index >= len(dataset):
        raise IndexError(f"sample-index {sample_index} out of range for dataset of size {len(dataset)}")
    subset = dataset[sample_index:]
    if sample_limit > 0:
        subset = subset[:sample_limit]
    return subset


def main() -> None:
    args = parse_args()
    dataset_path = Path(args.dataset).resolve()
    dataset = load_dataset(dataset_path)
    sample_targets: List[Tuple[int, Dict]] = []
    if args.sample_id:
        target = re.sub(r"[^a-z0-9]+", "", str(args.sample_id).strip().lower())
        for idx, sample in enumerate(dataset):
            sample_id = re.sub(r"[^a-z0-9]+", "", str(sample.get("sample_id", "")).strip().lower())
            if sample_id and sample_id == target:
                sample_targets.append((idx, sample))
        if not sample_targets:
            raise ValueError(f"sample-id {args.sample_id!r} not found in dataset {dataset_path}")
        samples = [sample for _, sample in sample_targets]
    else:
        samples = slice_samples(dataset, args.sample_index, args.sample_limit)

    args.storage_root = str(Path(args.storage_root).resolve())
    Path(args.storage_root).mkdir(parents=True, exist_ok=True)

    ollama_server = None
    if args.llm_base_url:
        llm_base_url = str(args.llm_base_url).rstrip("/")
        if not llm_base_url.endswith("/v1"):
            llm_base_url = f"{llm_base_url}/v1"
        embedding_host = str(args.embedding_host).rstrip("/") if args.embedding_host else "http://127.0.0.1:11435"
        ollama_host_for_report = llm_base_url
        ollama_log_for_report = "(external endpoint)"
    else:
        selected_port = choose_port(args.ollama_port)
        ollama_server = start_isolated_ollama(
            port=selected_port,
            gpu_devices=args.gpu_devices,
            keep_running=args.keep_ollama,
            models_dir=args.models_dir,
        )
        llm_base_url = f"{ollama_server.host}/v1"
        embedding_host = str(args.embedding_host).rstrip("/") if args.embedding_host else ollama_server.host
        ollama_host_for_report = ollama_server.host
        ollama_log_for_report = str(ollama_server.log_path)

    memory_utils.OLLAMA_HOST = embedding_host

    print("==================================================================")
    print("LoCoMo Benchmark")
    print("==================================================================")
    print(f"Dataset: {dataset_path}")
    if args.sample_id:
        indices = [str(idx) for idx, _ in sample_targets]
        suffix = f"sample-id={args.sample_id} indices={','.join(indices)}"
    else:
        suffix = f"from index {args.sample_index}"
    print(f"Samples: {len(samples)} ({suffix})")
    print(f"Question limit: {'all' if args.question_limit == 0 else args.question_limit}")
    print(f"LLM Base: {llm_base_url}")
    print(f"Embedding Host: {embedding_host}")
    print(f"CUDA_VISIBLE_DEVICES: {args.gpu_devices}")
    print(f"Ollama log: {ollama_log_for_report}")

    all_results = []
    if args.sample_id:
        positions = [idx for idx, _ in sample_targets]
    else:
        positions = list(range(args.sample_index, args.sample_index + len(samples)))

    for offset, sample in zip(positions, samples):
        all_results.append(
            evaluate_sample(
                sample=sample,
                sample_position=offset,
                args=args,
                llm_base_url=llm_base_url,
                embedding_host=embedding_host,
            )
        )

    all_records = [record for result in all_results for record in result["records"]]
    score_summary = summarize_score_metrics(all_records)
    salvage_summary = summarize_salvage_metrics(all_records)
    runtime_summary = summarize_runtime_metrics(all_records)
    final_report = {
        "dataset": str(dataset_path),
        "sample_index": args.sample_index,
        "sample_limit": args.sample_limit,
        "question_limit": args.question_limit,
        "gpu_devices": args.gpu_devices,
        "ollama_host": ollama_host_for_report,
        "llm_model": args.llm_model,
        "embedding_model": args.embedding_model,
        "sample_results": [
            {
                "sample_id": result["sample_id"],
                "user_id": result["user_id"],
                "question_count": result["question_count"],
                "em": result["em"],
                "f1": result["f1"],
                "recall_at_1": result["recall_at_1"],
                "recall_at_10": result["recall_at_10"],
                "latency_sec": result["latency_sec"],
                "retrieval_token_usage": result["retrieval_token_usage"],
                "reasoning_token_usage": result["reasoning_token_usage"],
                "answer_score": result["answer_score"],
                "citation_score": result["citation_score"],
                "final": result["final"],
                "forget_pool_salvage_count": result["forget_pool_salvage_count"],
                "questions_with_forget_pool_salvage": result["questions_with_forget_pool_salvage"],
                "forget_pool_salvage_rate": result["forget_pool_salvage_rate"],
                "avg_forget_pool_salvage_count": result["avg_forget_pool_salvage_count"],
                "trace_path": result.get("trace_path", ""),
            }
            for result in all_results
        ],
        "overall": {
            "question_count": len(all_records),
            "em": score_summary["answer_em"],
            "f1": score_summary["answer_f1"],
            **runtime_summary,
            **score_summary,
            **salvage_summary,
        },
        "records": all_records,
    }

    report_path = Path(args.report_path).resolve() if args.report_path else (
        PROJECT_ROOT / f"locomo_report_{int(time.time())}.json"
    )
    with report_path.open("w", encoding="utf-8") as handle:
        json.dump(final_report, handle, ensure_ascii=False, indent=2)

    print("\n==================================================================")
    print("LoCoMo Summary")
    print("==================================================================")
    print(f"Questions: {final_report['overall']['question_count']}")
    print(f"EM: {final_report['overall']['em']:.4f}")
    print(f"F1: {final_report['overall']['f1']:.4f}")
    print(f"Recall@1: {final_report['overall']['recall_at_1']:.4f}")
    print(f"Recall@10: {final_report['overall']['recall_at_10']:.4f}")
    print(f"Avg Latency: {final_report['overall']['latency_sec']:.4f}s")
    print(
        "Avg Retrieval Tokens: "
        f"{final_report['overall']['retrieval_token_usage']['avg_total_tokens']:.4f} "
        f"(calls={final_report['overall']['retrieval_token_usage']['avg_calls']:.4f})"
    )
    print(
        "Avg Reasoning Tokens: "
        f"{final_report['overall']['reasoning_token_usage']['avg_total_tokens']:.4f} "
        f"(prompt={final_report['overall']['reasoning_token_usage']['avg_prompt_tokens']:.4f}, "
        f"completion={final_report['overall']['reasoning_token_usage']['avg_completion_tokens']:.4f})"
    )
    print(
        "Forget-Pool Salvage: "
        f"{final_report['overall']['forget_pool_salvage_count']} hits across "
        f"{final_report['overall']['questions_with_forget_pool_salvage']} questions "
        f"(rate={final_report['overall']['forget_pool_salvage_rate']:.4f})"
    )
    print(f"Report: {report_path}")
    trace_paths = [result.get("trace_path") for result in all_results if result.get("trace_path")]
    if trace_paths:
        print(f"Trace: {trace_paths[0] if len(trace_paths) == 1 else ', '.join(trace_paths)}")

    if ollama_server is not None and not args.keep_ollama:
        ollama_server.stop()


if __name__ == "__main__":
    main()
