    )


def sanitize_model_answer_output(answer: str) -> str:
    text = str(answer or "").strip()
    if not text:
        return ""

    if text.startswith("{") and text.endswith("}"):
        try:
            payload = json.loads(text)
            for key in ("final_answer", "answer", "response"):
                value = payload.get(key)
                if isinstance(value, str) and value.strip():
                    text = value.strip()
                    break
        except Exception:
            pass

    if re.search(r"</think>", text, re.I):
        text = re.split(r"</think>", text, maxsplit=1, flags=re.I)[-1].strip()
    text = re.sub(r"<think>.*?</think>", " ", text, flags=re.I | re.S)
    text = re.sub(r"<thinking>.*?</thinking>", " ", text, flags=re.I | re.S)
    text = re.sub(r"^```(?:json|text)?\s*", "", text, flags=re.I)
    text = re.sub(r"\s*```$", "", text)
    text = text.strip().strip("`")

    lines = [line.strip() for line in text.splitlines() if line and line.strip()]
    for line in lines:
        cleaned = re.sub(r"^(?:final answer|answer|response)\s*[:：-]\s*", "", line, flags=re.I).strip(" \"'")
        if cleaned:
            return cleaned

    if not lines:
        return ""

    first_line = lines[0].lower()
    if len(lines) > 1 and (
        first_line.startswith(("okay", "first", "let's", "i need to", "the question"))
        or "<think" in first_line
    ):
        text = lines[-1]
    else:
        text = " ".join(lines)

    text = re.sub(r"^(?:final answer|answer|response)\s*[:：-]\s*", "", text, flags=re.I)
    return re.sub(r"\s+", " ", text).strip(" \"'")


def recover_answer_from_evidence(
    question: str,
    retrieval_results: Dict,
    *,
    inference_mode: bool = False,
    binary_mode: bool = False,
    list_mode: bool = False,
    temporal_mode: bool = False,
) -> str:
    if binary_mode:
        binary_answer = derive_binary_answer(question, retrieval_results)
        if binary_answer:
            return binary_answer

    if inference_mode:
        inference_answer = derive_inference_answer(question, retrieval_results)
        if inference_answer:
            return inference_answer

    multifact_answer = derive_multifact_answer(question, retrieval_results)
    if multifact_answer:
        return multifact_answer

    if list_mode:
        list_answer = build_generic_list_answer(question, retrieval_results)
        if list_answer:
            return list_answer

    if temporal_mode:
        temporal_answer = extract_best_temporal_answer_from_evidence(question, retrieval_results)
        if temporal_answer:
            return temporal_answer

    q_lower = question.lower().strip()
    question_names = [name.lower() for name in extract_question_names(question)]
    if q_lower.startswith("how old is "):
        for line in collect_relevant_evidence_lines(question, retrieval_results, limit=10):
            lower = line.lower()
            if question_names and not any(name in lower for name in question_names):
                continue
            match = re.search(r"\b\d+\s+years old\b", line, re.I)
            if match:
                return match.group(0)

    return ""


def retry_unknown_answer(
    memo: Memoryos,
    question: str,
    retrieval_results: Dict,
    answer_max_tokens: int,
    inference_mode: bool,
    list_mode: bool,
    temporal_mode: bool = False,
    adversarial_mode: bool = False,
) -> str:
    focused_snippets = collect_focused_evidence_snippets(question, retrieval_results, limit=8)
    relevant_lines = collect_relevant_evidence_lines(question, retrieval_results, limit=8)
    evidence_lines = focused_snippets or relevant_lines
    if not evidence_lines:
        return "Unknown"

    retry_prompt = (
        "You previously answered 'Unknown'. Re-check the evidence below.\n"
        "If any line directly supports the answer, output the shortest supported answer only.\n"
        "Do not add unsupported details."
    )
    if inference_mode:
        retry_prompt += "\nIf the question asks what is likely or would happen, make a conservative inference only from repeated stable evidence."
    if list_mode:
        retry_prompt += "\nIf multiple supported items exist, return a concise comma-separated list of all supported items."
    if temporal_mode:
        retry_prompt += "\nPrefer the time directly tied to the asked event or person, not a nearby session date."
    if adversarial_mode:
        retry_prompt += "\nDo not borrow facts from another person; the asked person and attribute must match in the same evidence."
    retry_prompt += (
        "\nIf the evidence still does not support an answer, return 'Unknown'.\n\n"
        "Evidence:\n"
        + "\n".join(f"- {line}" for line in evidence_lines)
        + f"\n\nQuestion: {question}\nAnswer:"
    )
    answer = memo.client.chat_completion(
        model=memo.llm_model,
        messages=[{"role": "user", "content": retry_prompt}],
        temperature=0.0,
        max_tokens=answer_max_tokens,
    )
    return sanitize_model_answer_output(answer)


def collect_profile_evidence(question: str, retrieval_results: Dict, limit: int = 14) -> List[str]:
    names = [name.lower() for name in extract_question_names(question)]
    q_terms = {
        token
        for token in re.findall(r"[a-z0-9]+", question.lower())
        if token
        not in {
            "what",
            "when",
            "where",
            "which",
            "how",
            "why",
            "would",
            "likely",
            "might",
            "could",
            "should",
            "is",
            "are",
            "the",
            "a",
            "an",
            "her",
            "his",
            "their",
            "she",
            "he",
            "they",
        }
    }
    profile_markers = {
        "likes",
        "like",
        "loves",
        "enjoys",
        "enjoy",
        "favorite",
        "identity",
        "supportive",
        "support",
        "goal",
        "goals",
        "wants",
        "want",
        "career",
        "counseling",
        "mental",
        "books",
        "collects",
        "outdoors",
        "camping",
        "hiking",
        "faith",
        "church",
        "activist",
        "activism",
        "community",
        "classical",
        "music",
        "adoption",
        "roadtrip",
        "family",
        "religious",
    }
    scored: List[Tuple[float, str]] = []
    corpus = collect_retrieval_corpus(retrieval_results)

    for unit in split_into_evidence_units(corpus):
        lower = unit.lower()
        unit_terms = set(re.findall(r"[a-z0-9]+", lower))
        overlap = len(q_terms & unit_terms)
        if overlap == 0 and names and not any(name in lower for name in names):
            continue
        score = float(overlap)
        if names and any(name in lower for name in names):
            score += 1.0
        score += 0.35 * len(profile_markers & unit_terms)
        if any(marker in lower for marker in ["session summary:", "event summary:", "observations:"]):
            score -= 0.15
        if len(unit) > 320:
            score -= 0.2
        if score > 0.8:
            scored.append((score, unit))

    scored.sort(key=lambda item: item[0], reverse=True)
    result: List[str] = []
    for _, unit in scored:
        if unit not in result:
            result.append(unit)
        if len(result) >= limit:
            break
    return result


def derive_inference_answer(question: str, retrieval_results: Dict) -> Optional[str]:
    q_lower = question.lower().strip()
    corpus = collect_retrieval_corpus(retrieval_results)
    profile_lines = collect_profile_evidence(question, retrieval_results, limit=18)
    profile_corpus = "\n".join(profile_lines) if profile_lines else corpus

    if "what fields would" in q_lower and "education" in q_lower:
        parts = []
        if re.search(r"\bpsychology\b", profile_corpus, re.I):
            parts.append("Psychology")
        if re.search(r"counseling certification", profile_corpus, re.I):
            parts.append("counseling certification")
        elif re.search(r"\bcounseling\b", profile_corpus, re.I):
            parts.append("counseling")
        if len(parts) >= 2:
            return ", ".join(parts)

    if "dr. seuss" in q_lower and re.search(r"classic children'?s books|collects classic books", profile_corpus, re.I):
        return "Yes, since she collects classic children's books"

    if "writing as a career" in q_lower and re.search(r"counseling|mental health", profile_corpus, re.I):
        return "Likely no; though she likes reading, she wants to be a counselor"

    if "member of the lgbtq community" in q_lower:
        if re.search(r"ally|supportive|support the lgbtq community|supports the lgbtq community", profile_corpus, re.I):
            return "Likely no, she does not refer to herself as part of it"

    if "ally to the transgender community" in q_lower:
        if re.search(r"supportive|support the transgender community|voice to the trans community|support the lgbtq community", profile_corpus, re.I):
            return "Yes, she is supportive"

    if "political leaning" in q_lower:
        if re.search(r"activist|equality|acceptance|inclusion|lgbtq|trans community", profile_corpus, re.I):
            return "Liberal"

    if "considered religious" in q_lower:
        if re.search(r"church|faith", profile_corpus, re.I):
            return "Somewhat, but not extremely religious"

    if "national park or a theme park" in q_lower:
        if re.search(r"outdoors|camping|hiking|nature|national park", profile_corpus, re.I):
            return "National park; she likes the outdoors"

    if "the four seasons" in q_lower or "vivaldi" in q_lower:
        if re.search(r"classical music|classical musicians?|mozart|beethoven|vivaldi", profile_corpus, re.I):
            return "Yes; it's classical music"

    if "go on another roadtrip soon" in q_lower:
        if re.search(r"accident|went badly|rough road trip|stressful road trip", profile_corpus, re.I):
            return "Likely no; since this one went badly"

    if "move back to her home country soon" in q_lower:
        if re.search(r"adoption|adoption agenc|creating a family|adopt", profile_corpus, re.I):
            return "No; she's in the process of adopting children."

    if "close to the beach or the mountains" in q_lower:
        if re.search(r"beach nearby|near the beach|close to the beach|beach is nearby", profile_corpus, re.I):
            return "beach"

    return None


def derive_binary_answer(question: str, retrieval_results: Dict) -> Optional[str]:
    q_lower = question.lower().strip()
    corpus = collect_retrieval_corpus(retrieval_results)
    profile_lines = collect_profile_evidence(question, retrieval_results, limit=18)
    profile_corpus = "\n".join(profile_lines) if profile_lines else corpus

    if "married" in q_lower:
        if re.search(r"\bhusband\b|\bwife\b|got married|married on", profile_corpus, re.I):
            return "Yes"
        if re.search(r"\bnot married\b|\bsingle\b|\bunmarried\b", profile_corpus, re.I):
            return "No"

    if "religious" in q_lower:
        if re.search(r"\bchurch\b|\bfaith\b|\breligious\b", profile_corpus, re.I):
            return "Yes"

    if "ally" in q_lower:
        if re.search(r"\bally\b|supportive|support(?:s|ive)? .*community|voice to the trans community", profile_corpus, re.I):
            return "Yes"

    if "member of the lgbtq community" in q_lower:
        if re.search(r"\bally\b|supportive|support(?:s|ive)? the lgbtq community", profile_corpus, re.I):
            return "No"

    if "been to rio de janeiro" in q_lower:
        if re.search(r"trip to rio de janeiro|got back from .*rio de janeiro|in rio de janeiro", profile_corpus, re.I):
            return "Yes"

    if "tried surfing" in q_lower:
        if re.search(r"haven't tried surfing|have not tried surfing|never tried surfing|not tried surfing", profile_corpus, re.I):
            return "No"
        if re.search(r"tried surfing|went surfing|surfing last", profile_corpus, re.I):
            return "Yes"

    return None


def answer_inference_question(
    memo: Memoryos,
    question: str,
    retrieval_results: Dict,
    answer_max_tokens: int,
    list_mode: bool,
    binary_mode: bool = False,
) -> str:
    if binary_mode:
        binary_answer = derive_binary_answer(question, retrieval_results)
        if binary_answer:
            return binary_answer

    heuristic_answer = derive_inference_answer(question, retrieval_results)
    if heuristic_answer:
        return heuristic_answer

    profile_lines = collect_profile_evidence(question, retrieval_results, limit=14)
    if not profile_lines:
        profile_lines = collect_focused_evidence_snippets(question, retrieval_results, limit=10)
    if not profile_lines:
        return "Unknown"

    answer_shape = (
        "Return exactly one token: Yes, No, or Unknown."
        if binary_mode
        else
        "Return a concise comma-separated list."
        if list_mode
        else "Return a concise answer, using 'Likely yes', 'Likely no', or a short noun phrase when appropriate."
    )
    inference_prompt = (
        "You are doing conservative preference/persona inference from memory evidence.\n"
        "Infer the most likely answer only when the evidence shows a stable habit, trait, identity, preference, or long-term goal.\n"
        "If the evidence is too weak or contradictory, return 'Unknown'.\n"
        "Keep the asked person and attribute bound together in the same evidence.\n"
        f"{answer_shape}\n\n"
        "Profile Evidence:\n"
        + "\n".join(f"- {line}" for line in profile_lines)
        + f"\n\nQuestion: {question}\nAnswer:"
    )
    answer = memo.client.chat_completion(
        model=memo.llm_model,
        messages=[{"role": "user", "content": inference_prompt}],
        temperature=0.0,
        max_tokens=answer_max_tokens,
    )
    return sanitize_model_answer_output(answer)


def split_answer_list_items(answer: str) -> List[str]:
    parts = re.split(r",| and |;|\n", str(answer or ""))
    return [part.strip() for part in parts if part and part.strip()]


def strengthen_list_answer(question: str, answer: str, retrieval_results: Dict) -> str:
    heuristic_answer = build_generic_list_answer(question, retrieval_results)
    if not heuristic_answer:
        return answer

    normalized_answer = normalize_text(answer)
    model_items = dedupe_list_items(split_answer_list_items(answer))
    heuristic_items = dedupe_list_items(split_answer_list_items(heuristic_answer))
    if normalized_answer == "unknown":
        return ", ".join(heuristic_items)
    if len(model_items) < len(heuristic_items):
        return ", ".join(heuristic_items)
    merged_items = dedupe_list_items(model_items + heuristic_items)
    if len(merged_items) > len(model_items):
        return ", ".join(merged_items)
    return answer


def _page_rank_score(page: Dict[str, Any]) -> float:
    return float(
        page.get("locomo_rerank_score", page.get("locomo_base_rerank_score", page.get("final_score", page.get("score", 0.0))))
    )


def score_citation_page_support(question: str, answer: str, page: Dict[str, Any]) -> float:
    answer = str(answer or "").strip()
    if not answer or normalize_text(answer) == "unknown":
        return 0.0

    temporal_mode = question_is_temporal(question)
    answer_terms = {
        token
        for token in re.findall(r"[a-z0-9]+", answer.lower())
        if token not in {"the", "a", "an", "and", "or", "in", "on", "at", "of"}
    }
    answer_temporal_forms = set(extract_temporal_canonical_forms(answer)) if temporal_mode else set()
    question_terms = extract_question_terms(question)
    question_names = [name.lower() for name in extract_question_names(question)]
    best_score = 0.0

    raw_text = page.get("raw_content") or page.get("agent_response") or page.get("summary") or ""
    for unit in split_into_evidence_units(raw_text):
        lower = unit.lower()
        unit_terms = set(re.findall(r"[a-z0-9]+", lower))
        score = score_evidence_line(question, unit, question_terms=question_terms, temporal=temporal_mode)
        if answer_terms:
            overlap = len(answer_terms & unit_terms) / float(max(1, len(answer_terms)))
            score += 1.35 * overlap
        if temporal_mode and answer_temporal_forms:
            unit_forms = set(extract_temporal_canonical_forms(unit))
            if unit_forms & answer_temporal_forms:
                score += 1.8
        if question_names and any(name in lower for name in question_names):
            score += 0.3
        if normalize_text(answer) and normalize_text(answer) in normalize_text(unit):
            score += 0.5
        best_score = max(best_score, score)

    graph_meta = page.get("graph_1hop", {}) if isinstance(page.get("graph_1hop"), dict) else {}
    if page.get("_source") == "GRAPH_1HOP":
        matched_entities = len(graph_meta.get("matched_entities", []) or [])
        if best_score > 0.0:
            best_score += 0.25 + (0.08 * matched_entities)
        else:
            best_score -= 0.25
    return round(best_score, 6)


def select_top_citations(
    question: str,
    retrieval_results: Dict[str, Any],
    answer: str = "",
    max_citations: int = 3,
) -> List[str]:
    pages = retrieval_results.get("retrieved_pages", []) or []
    if not pages:
        return []

    scored_pages: List[Tuple[float, int, str]] = []
    unknown_answer = normalize_text(answer) == "unknown"
    for index, page in enumerate(pages):
        citation_id = page.get("citation_id") or page.get("page_id") or page.get("id")
        if not citation_id:
            continue
        if unknown_answer:
            score = _page_rank_score(page)
        else:
            score = (3.0 * score_citation_page_support(question, answer, page)) + (0.15 * _page_rank_score(page))
        scored_pages.append((score, -index, str(citation_id)))

    scored_pages.sort(reverse=True)
    citations: List[str] = []
    for _, _, citation_id in scored_pages:
        if citation_id in citations:
            continue
        citations.append(citation_id)
        if len(citations) >= max_citations:
            break
    return citations


@dataclass(frozen=True)
class LocomoAnswerVerifierCalibration:
    question_shape: str
    min_best_support: float
    min_positive_pages: int
    min_source_votes: int
    require_grounding: bool
    allow_focused_verifier: bool
    allow_non_unknown_override: bool
    min_override_support_gap: float
    min_override_grounding_hits: int


def classify_locomo_question_shape(
    question: str,
    *,
    inference_mode: bool,
    binary_mode: bool,
    list_mode: bool,
    temporal_mode: bool,
) -> str:
    q_lower = question.lower().strip()
    if binary_mode:
        return "binary_inference"
    if inference_mode:
        return "persona_inference"
    if list_mode:
        return "list_lookup"
    if q_lower.startswith("how old"):
        return "age_lookup"
    if temporal_mode:
        if q_lower.startswith("which year"):
            return "year_lookup"
        if q_lower.startswith("how long"):
            return "duration_lookup"
        return "temporal_lookup"
    if q_lower.startswith("where"):
        return "location_lookup"
    if q_lower.startswith("who"):
        return "entity_lookup"
    return "fact_lookup"


def build_locomo_answer_verifier_calibration(
    question_shape: str,
    *,
    adversarial_mode: bool = False,
) -> LocomoAnswerVerifierCalibration:
    profile = {
        "list_lookup": LocomoAnswerVerifierCalibration("list_lookup", 1.55, 1, 1, True, False, False, 0.9, 2),
        "age_lookup": LocomoAnswerVerifierCalibration("age_lookup", 1.45, 1, 1, True, False, True, 0.75, 1),
        "year_lookup": LocomoAnswerVerifierCalibration("year_lookup", 1.5, 1, 1, True, False, True, 0.75, 1),
        "duration_lookup": LocomoAnswerVerifierCalibration("duration_lookup", 1.6, 1, 1, True, False, True, 0.8, 1),
        "temporal_lookup": LocomoAnswerVerifierCalibration("temporal_lookup", 1.6, 1, 1, True, False, True, 0.8, 1),
        "location_lookup": LocomoAnswerVerifierCalibration("location_lookup", 1.45, 1, 1, True, True, True, 0.75, 1),
        "entity_lookup": LocomoAnswerVerifierCalibration("entity_lookup", 1.45, 1, 1, True, True, True, 0.75, 1),
        # Open-ended fact questions are safe for Unknown recovery but too unstable for answer rewrites.
        "fact_lookup": LocomoAnswerVerifierCalibration("fact_lookup", 1.55, 1, 1, True, True, False, 1.0, 2),
        "binary_inference": LocomoAnswerVerifierCalibration("binary_inference", 99.0, 99, 99, True, False, False, 99.0, 99),
        "persona_inference": LocomoAnswerVerifierCalibration("persona_inference", 99.0, 99, 99, True, False, False, 99.0, 99),
    }.get(question_shape, LocomoAnswerVerifierCalibration(question_shape, 1.55, 1, 1, True, True, False, 1.0, 2))
    if not adversarial_mode:
        return profile
    return LocomoAnswerVerifierCalibration(
        question_shape=profile.question_shape,
        min_best_support=round(profile.min_best_support + 0.2, 4),
        min_positive_pages=profile.min_positive_pages,
        min_source_votes=max(profile.min_source_votes, 1),
        require_grounding=profile.require_grounding,
        allow_focused_verifier=profile.allow_focused_verifier,
        allow_non_unknown_override=profile.allow_non_unknown_override,
        min_override_support_gap=round(profile.min_override_support_gap + 0.15, 4),
        min_override_grounding_hits=max(profile.min_override_grounding_hits, 1),
    )


def build_locomo_verifier_prompt(
    question: str,
    evidence_lines: List[str],
    *,
    question_shape: str,
    list_mode: bool,
    temporal_mode: bool,
    adversarial_mode: bool,
) -> str:
    answer_rule = "Return the shortest supported answer only."
    if list_mode:
        answer_rule = "Return a concise comma-separated list of all supported items only."
    elif temporal_mode:
        answer_rule = "Return the shortest supported time expression only."
    binding_rule = ""
    if adversarial_mode:
        binding_rule = "\nKeep the asked person, relation, and attribute bound together in the same evidence."
    return (
        "You are validating whether the evidence supports a concrete answer.\n"
        "If the answer is unsupported or ambiguous, return 'Unknown'.\n"
        f"Question Shape: {question_shape}\n"
        f"{answer_rule}"
        f"{binding_rule}\n\n"
        "Verifier Evidence:\n"
        + "\n".join(f"- {line}" for line in evidence_lines)
        + f"\n\nQuestion: {question}\nAnswer:"
    )


def propose_locomo_focused_verifier_answer(
    memo: Memoryos,
    question: str,
    retrieval_results: Dict[str, Any],
    *,
    answer_max_tokens: int,
    question_shape: str,
    list_mode: bool,
    temporal_mode: bool,
    adversarial_mode: bool,
) -> str:
    evidence_lines = collect_focused_evidence_snippets(question, retrieval_results, limit=8)
    if not evidence_lines:
        evidence_lines = collect_relevant_evidence_lines(question, retrieval_results, limit=8)
    if not evidence_lines:
        return ""
    prompt = build_locomo_verifier_prompt(
        question,
        evidence_lines,
        question_shape=question_shape,
        list_mode=list_mode,
        temporal_mode=temporal_mode,
        adversarial_mode=adversarial_mode,
    )
    answer = memo.client.chat_completion(
        model=memo.llm_model,
        messages=[{"role": "user", "content": prompt}],
        temperature=0.0,
        max_tokens=max(24, min(answer_max_tokens, 96)),
    )
    return sanitize_model_answer_output(answer)


def collect_locomo_verifier_candidates(
    memo: Memoryos,
    question: str,
    retrieval_results: Dict[str, Any],
    *,
    answer_max_tokens: int,
    question_shape: str,
    calibration: LocomoAnswerVerifierCalibration,
    inference_mode: bool,
    binary_mode: bool,
    list_mode: bool,
    temporal_mode: bool,
    adversarial_mode: bool,
) -> List[Dict[str, Any]]:
    candidates: List[Tuple[str, str]] = []

    def add_candidate(source: str, value: str) -> None:
        cleaned = sanitize_model_answer_output(value)
        if not cleaned or normalize_text(cleaned) == "unknown":
            return
        candidates.append((source, cleaned))

    if list_mode:
        add_candidate("generic_list", build_generic_list_answer(question, retrieval_results) or "")
    if temporal_mode:
        add_candidate("temporal_extract", extract_best_temporal_answer_from_evidence(question, retrieval_results) or "")
    add_candidate(
        "heuristic_recovery",
        recover_answer_from_evidence(
            question,
            retrieval_results,
            inference_mode=inference_mode,
            binary_mode=binary_mode,
            list_mode=list_mode,
            temporal_mode=temporal_mode,
        )
        or "",
    )
    add_candidate("multifact", derive_multifact_answer(question, retrieval_results) or "")

    if calibration.allow_focused_verifier:
        add_candidate(
            "focused_verifier",
            propose_locomo_focused_verifier_answer(
                memo,
                question,
                retrieval_results,
                answer_max_tokens=answer_max_tokens,
                question_shape=question_shape,
                list_mode=list_mode,
                temporal_mode=temporal_mode,
                adversarial_mode=adversarial_mode,
            ),
        )

    grouped: Dict[str, Dict[str, Any]] = {}
    for source, candidate in candidates:
        key = normalize_text(candidate)
        if not key:
            continue
        bucket = grouped.setdefault(
            key,
            {
                "candidate": candidate,
                "sources": [],
            },
        )
        if source not in bucket["sources"]:
            bucket["sources"].append(source)
    return list(grouped.values())


def summarize_locomo_candidate_support(
    question: str,
    candidate: str,
    retrieval_results: Dict[str, Any],
    *,
    temporal_mode: bool,
    list_mode: bool,
) -> Dict[str, Any]:
    candidate = str(candidate or "").strip()
    page_scores = [
        float(score_citation_page_support(question, candidate, page))
        for page in (retrieval_results.get("retrieved_pages", []) or [])[:8]
    ]
    page_scores = sorted(page_scores, reverse=True)
    best_support = page_scores[0] if page_scores else 0.0
    positive_pages = sum(1 for score in page_scores if score >= 1.0)
    support_sum_top2 = round(sum(page_scores[:2]), 4)

    evidence_lines = collect_relevant_evidence_lines(question, retrieval_results, limit=12)
    normalized_candidate = normalize_text(candidate)
    grounding_hits = 0
    if list_mode:
        items = [normalize_text(item) for item in split_answer_list_items(candidate)]
        items = [item for item in items if item and item != "unknown"]
        if items:
            for line in evidence_lines:
                normalized_line = normalize_text(line)
                if all(item in normalized_line for item in items):
                    grounding_hits += 1
    elif temporal_mode:
        for line in evidence_lines:
            if temporal_answers_equivalent(candidate, line) or (
                normalized_candidate and normalized_candidate in normalize_text(line)
            ):
                grounding_hits += 1
    else:
        for line in evidence_lines:
            if normalized_candidate and normalized_candidate in normalize_text(line):
                grounding_hits += 1

    return {
        "best_support": round(best_support, 4),
        "positive_pages": positive_pages,
        "support_sum_top2": support_sum_top2,
        "grounding_hits": grounding_hits,
        "grounded": grounding_hits > 0,
    }


def maybe_apply_locomo_shape_adaptive_answer_verifier(
    memo: Memoryos,
    question: str,
    answer: str,
    retrieval_results: Dict[str, Any],
    *,
    answer_max_tokens: int,
    inference_mode: bool,
    binary_mode: bool,
    list_mode: bool,
    temporal_mode: bool,
    adversarial_mode: bool,
    enabled: bool = False,
) -> Tuple[str, Dict[str, Any]]:
    current_answer = sanitize_model_answer_output(answer)
    question_shape = classify_locomo_question_shape(
        question,
        inference_mode=inference_mode,
        binary_mode=binary_mode,
        list_mode=list_mode,
        temporal_mode=temporal_mode,
    )
    decision = {
        "enabled": bool(enabled),
        "applied": False,
        "reason": "",
        "question_shape": question_shape,
        "current_answer": current_answer,
        "current_support": 0.0,
        "candidate": "",
        "sources": [],
        "source_votes": 0,
        "best_support": 0.0,
        "positive_pages": 0,
        "support_sum_top2": 0.0,
        "grounding_hits": 0,
        "current_grounding_hits": 0,
        "required_override_support_gap": 0.0,
        "required_override_grounding_hits": 0,
    }
    if not enabled:
        decision["reason"] = "disabled"
        return current_answer, decision
    if not has_actionable_evidence(question, retrieval_results):
        decision["reason"] = "no_actionable_evidence"
        return current_answer, decision

    calibration = build_locomo_answer_verifier_calibration(
        question_shape,
        adversarial_mode=adversarial_mode,
    )
    if calibration.question_shape in {"binary_inference", "persona_inference"}:
        decision["reason"] = "unsupported_question_shape"
        return current_answer, decision

    current_support = summarize_locomo_candidate_support(
        question,
        current_answer,
        retrieval_results,
        temporal_mode=temporal_mode,
        list_mode=list_mode,
    )
    decision["current_support"] = current_support["best_support"]
    decision["current_grounding_hits"] = current_support["grounding_hits"]
    decision["required_override_support_gap"] = float(calibration.min_override_support_gap)
    decision["required_override_grounding_hits"] = int(calibration.min_override_grounding_hits)

    candidates = collect_locomo_verifier_candidates(
        memo,
        question,
        retrieval_results,
        answer_max_tokens=answer_max_tokens,
        question_shape=question_shape,
        calibration=calibration,
        inference_mode=inference_mode,
        binary_mode=binary_mode,
        list_mode=list_mode,
        temporal_mode=temporal_mode,
        adversarial_mode=adversarial_mode,
    )
    if not candidates:
        decision["reason"] = "no_candidate"
        return current_answer, decision

    ranked: List[Tuple[float, Dict[str, Any], Dict[str, Any]]] = []
    for item in candidates:
        support = summarize_locomo_candidate_support(
            question,
            item["candidate"],
            retrieval_results,
            temporal_mode=temporal_mode,
            list_mode=list_mode,
        )
        score = float(support["best_support"]) + (0.18 * min(len(item["sources"]) - 1, 2))
        if support["grounded"]:
            score += 0.15
        score += 0.05 * min(int(support["positive_pages"]), 2)
        ranked.append((score, item, support))

    ranked.sort(key=lambda entry: entry[0], reverse=True)
    _, best_candidate, support = ranked[0]
    decision.update(
        {
            "candidate": best_candidate["candidate"],
            "sources": list(best_candidate["sources"]),
            "source_votes": len(best_candidate["sources"]),
            "best_support": support["best_support"],
            "positive_pages": support["positive_pages"],
            "support_sum_top2": support["support_sum_top2"],
            "grounding_hits": support["grounding_hits"],
        }
    )

    current_is_unknown = normalize_text(current_answer) == "unknown"
    current_is_supported = (
        float(current_support["best_support"]) >= float(calibration.min_best_support)
        and int(current_support["positive_pages"]) >= int(calibration.min_positive_pages)
        and bool(current_support["grounded"])
    )
    if not current_is_unknown and current_is_supported:
        decision["reason"] = "current_answer_supported"
        return current_answer, decision

    if calibration.require_grounding and not support["grounded"]:
        decision["reason"] = "candidate_not_grounded"
        return current_answer, decision
    if int(support["positive_pages"]) < int(calibration.min_positive_pages):
        decision["reason"] = "insufficient_positive_pages"
        return current_answer, decision
    required_votes = int(calibration.min_source_votes)
    if len(best_candidate["sources"]) < required_votes and float(support["best_support"]) < float(calibration.min_best_support) + 0.45:
        decision["reason"] = "insufficient_source_agreement"
        return current_answer, decision
    if float(support["best_support"]) < float(calibration.min_best_support):
        decision["reason"] = "best_support_below_threshold"
        return current_answer, decision
    if not current_is_unknown:
        if not calibration.allow_non_unknown_override:
            decision["reason"] = "non_unknown_override_disabled_for_shape"
            return current_answer, decision
        if int(support["grounding_hits"]) < int(calibration.min_override_grounding_hits):
            decision["reason"] = "insufficient_override_grounding"
            return current_answer, decision
        support_gap = float(support["best_support"]) - float(current_support["best_support"])
        if support_gap < float(calibration.min_override_support_gap):
            decision["reason"] = "candidate_not_better_than_current_answer"
            return current_answer, decision

    decision["applied"] = True
    decision["reason"] = "shape_adaptive_answer_override"
    return best_candidate["candidate"], decision


def answer_question(
    memo: Memoryos,
    question: str,
    max_results: int,
    token_budget: int,
    answer_max_tokens: int,
    evidence_pages: int,
    context_mode: str = "full",
    context_lines_per_page: int = 4,
    disable_planner: bool = False,
    enable_shape_adaptive_answer_verifier: bool = False,
    trace_base: Optional[Dict[str, Any]] = None,
) -> Tuple[str, Dict]:
    primary_trace_context = dict(trace_base or {})
    primary_trace_context.update({"query_kind": "primary", "query_text": question})
    retrieval_results = annotate_retrieval_result(
        memo.retrieve_context(
            question,
            max_results=max_results,
            token_budget=token_budget,
            trace_context=primary_trace_context,
        ),
        planner_query_tier="primary",
        query_text=question,
    )
    inference_mode = question_requires_inference(question)
    binary_mode = question_is_binary(question)
    list_mode = question_expects_list(question)
    temporal_mode = question_is_temporal(question)
    adversarial_mode = question_is_adversarial(question)
    retrieval_plan: Dict[str, Any] = {}
    if not disable_planner:
        retrieval_plan = plan_retrieval_queries(memo, question)

    global_queries = list(retrieval_plan.get("global_queries", []))
    local_queries = list(retrieval_plan.get("local_queries", []))
    explicit_queries = list(retrieval_plan.get("explicit_queries", []))
    heuristic_queries = build_expanded_queries(question)
    if disable_planner or (not global_queries and not local_queries and not explicit_queries):
        names = extract_question_names(question)
        subject = " ".join(names) if names else "person"
        terms = sorted(extract_question_terms(question))
        phrases = extract_question_phrases(question)
        if terms:
            heuristic_queries.append(f"{subject} {' '.join(terms[:8])}")
        for phrase in phrases[:3]:
            heuristic_queries.append(f"{subject} {phrase}")
    if inference_mode or binary_mode:
        global_queries.extend(
            [
                f"{' '.join(extract_question_names(question)) or 'person'} stable traits preferences identity goals habits values",
                f"{' '.join(extract_question_names(question)) or 'person'} likes enjoys supports wants career books outdoors family beliefs",
            ]
        )
    else:
        local_queries.extend(explicit_queries)
        local_queries.extend(heuristic_queries)

    if inference_mode or binary_mode:
        global_queries.extend(explicit_queries)
        local_queries.extend(heuristic_queries)

    global_queries = _dedupe_queries(global_queries, question=question)
    local_queries = _dedupe_queries(local_queries, question=question)

    extra_results: List[Dict[str, Any]] = []
    for expanded_index, expanded_query in enumerate(global_queries, start=1):
        extra_results.append(
            annotate_retrieval_result(
                memo.retrieve_context(
                    expanded_query,
                    max_results=max_results,
                    token_budget=token_budget,
                    trace_context={
                        **dict(trace_base or {}),
                        "query_kind": "global",
                        "query_text": expanded_query,
                        "expanded_from": question,
                        "expanded_query_index": expanded_index,
                    },
                ),
                planner_query_tier="global",
                query_text=expanded_query,
            )
        )
    for expanded_index, expanded_query in enumerate(local_queries, start=1):
        extra_results.append(
            annotate_retrieval_result(
                memo.retrieve_context(
                    expanded_query,
                    max_results=max_results,
                    token_budget=token_budget,
                    trace_context={
                        **dict(trace_base or {}),
                        "query_kind": "local",
                        "query_text": expanded_query,
                        "expanded_from": question,
                        "expanded_query_index": expanded_index,
                    },
                ),
                planner_query_tier="local",
                query_text=expanded_query,
            )
        )

    if extra_results:
        retrieval_results = merge_retrieval_results(retrieval_results, extra_results)
    retrieval_results["retrieval_plan"] = {
        "need": retrieval_plan.get("need", ""),
        "answer_mode": retrieval_plan.get("answer_mode", ""),
        "global_dependencies": list(retrieval_plan.get("global_dependencies", [])),
        "local_dependencies": list(retrieval_plan.get("local_dependencies", [])),
        "explicit_queries": list(explicit_queries),
        "global_queries": list(global_queries),
        "local_queries": list(local_queries),
        "queries": list(dict.fromkeys(global_queries + local_queries)),
    }
    retrieval_results = rerank_retrieval_results(question, retrieval_results)
    retrieval_results = apply_slot_filtering(question, retrieval_results)
    retrieval_results = apply_planner_channel_quota(
        retrieval_results,
        max_results=max_results,
        inference_mode=inference_mode,
        binary_mode=binary_mode,
        list_mode=list_mode,
        temporal_mode=temporal_mode,
    )
    heuristic_answer = ""
    if not inference_mode and not binary_mode:
        heuristic_answer = derive_multifact_answer(question, retrieval_results) or ""
    context_block = build_context_block(
        question,
        retrieval_results,
        max_pages=evidence_pages,
        mode=context_mode,
        lines_per_page=context_lines_per_page,
    )
    if inference_mode or binary_mode:
        answer = answer_inference_question(
            memo,
            question,
            retrieval_results,
            answer_max_tokens=answer_max_tokens,
            list_mode=list_mode,
            binary_mode=binary_mode,
        )
    elif heuristic_answer:
        answer = heuristic_answer
    else:
        prompt = build_answer_prompt(
            question,
            context_block,
            inference_mode=False,
            list_mode=list_mode,
            temporal_mode=temporal_mode,
            adversarial_mode=adversarial_mode,
        )
        answer = memo.client.chat_completion(
            model=memo.llm_model,
            messages=[{"role": "user", "content": prompt}],
            temperature=0.0,
            max_tokens=answer_max_tokens,
        )
        answer = sanitize_model_answer_output(answer)
    if normalize_text(answer) == "unknown" and has_actionable_evidence(question, retrieval_results):
        retry_answer = retry_unknown_answer(
            memo,
            question,
            retrieval_results,
            answer_max_tokens=answer_max_tokens,
            inference_mode=inference_mode or binary_mode,
            list_mode=list_mode,
            temporal_mode=temporal_mode,
            adversarial_mode=adversarial_mode,
        )
        if retry_answer:
            answer = sanitize_model_answer_output(retry_answer)
    if not str(answer or "").strip() and has_actionable_evidence(question, retrieval_results):
        recovered_answer = recover_answer_from_evidence(
            question,
            retrieval_results,
            inference_mode=inference_mode,
            binary_mode=binary_mode,
            list_mode=list_mode,
            temporal_mode=temporal_mode,
        )
        if recovered_answer:
            answer = recovered_answer
    if list_mode:
        answer = strengthen_list_answer(question, (answer or "").strip(), retrieval_results)
    answer = postprocess_temporal_answer(question, (answer or "").strip(), retrieval_results)
    answer, answer_verifier = maybe_apply_locomo_shape_adaptive_answer_verifier(
        memo,
        question,
        answer,
        retrieval_results,
        answer_max_tokens=answer_max_tokens,
        inference_mode=inference_mode,
        binary_mode=binary_mode,
        list_mode=list_mode,
        temporal_mode=temporal_mode,
        adversarial_mode=adversarial_mode,
        enabled=enable_shape_adaptive_answer_verifier,
    )
    retrieval_results["answer_verifier"] = answer_verifier
    retrieval_results["citations"] = select_top_citations(question, retrieval_results, answer=answer, max_citations=3)
    return answer, retrieval_results


def evaluate_sample(
    sample: Dict,
    sample_position: int,
    args: argparse.Namespace,
    llm_base_url: str,
    embedding_host: str,
) -> Dict:
    unique_user_id = f"locomo_{sample.get('sample_id', sample_position)}_{int(time.time())}"
    trace_recorder = None
    trace_path = ""
    if args.trace_output:
        trace_path = str(resolve_trace_output_path(args.trace_output, sample, sample_position))
        trace_recorder = TraceRecorder(
            trace_path,
            run_metadata={
                "benchmark": "locomo",
                "sample_id": sample.get("sample_id"),
                "sample_position": sample_position,
                "dataset": "locomo",
            },
        )
    memo = Memoryos(
        user_id=unique_user_id,
        openai_api_key="ollama",
        openai_base_url=llm_base_url,
        planner_base_url=args.planner_base_url or llm_base_url,
        data_storage_path=args.storage_root,
        llm_model=args.llm_model,
        planner_model=args.planner_model or args.llm_model,
        embedding_model_name=args.embedding_model,
        short_term_capacity=args.short_term_capacity,
        long_term_knowledge_capacity=args.long_term_capacity,
        retrieval_queue_capacity=args.retrieval_queue_capacity,
        trace_recorder=trace_recorder,
        lightweight_extraction=args.benchmark_light,
        keyword_ranker_path=args.keyword_ranker_path or None,
        enable_graph_one_hop=args.enable_graph_one_hop,
        persist_access_updates=False,
    )
    memory_utils.OLLAMA_HOST = embedding_host

    ingested_memory_count = 0
    records = []
    try:
        for session_id in iter_session_ids(sample["conversation"]):
            for memory_entry in build_locomo_memory_entries(sample, session_id, args):
                memo.add_memory(
                    user_input=memory_entry["user_input"],
                    agent_response=memory_entry["agent_response"],
                    meta_data=memory_entry.get("metadata"),
                )
                ingested_memory_count += 1

        questions = sample.get("qa", [])
        if args.question_limit > 0:
            questions = questions[: args.question_limit]

        em_scores = []
        f1_scores = []

        print(
            f"\n[Sample {sample_position}] {sample.get('sample_id')} | "
            f"sessions={len(iter_session_ids(sample['conversation']))} | memories={ingested_memory_count} | questions={len(questions)}"
        )

        for index, qa in enumerate(questions, start=1):
            question = str(qa.get("question", "")).strip()
            gold_answer = get_gold_answer(qa)
            trace_context = {
                "sample_id": sample.get("sample_id"),
                "sample_position": sample_position,
                "question_index": index,
                "question_category": qa.get("category"),
            }
            memo.client.clear_usage_history()
            memory_utils.clear_embedding_usage_history()
            start_time = time.perf_counter()
            prediction, retrieval_results = answer_question(
                memo,
                question,
                max_results=args.max_results,
                token_budget=args.token_budget,
                answer_max_tokens=args.answer_max_tokens,
                evidence_pages=args.evidence_pages,
                context_mode=args.context_mode,
                context_lines_per_page=args.context_lines_per_page,
                disable_planner=args.disable_planner,
                enable_shape_adaptive_answer_verifier=bool(args.enable_shape_adaptive_answer_verifier),
                trace_base=trace_context,
            )
            latency = time.perf_counter() - start_time
            retrieval_token_usage = memory_utils.summarize_usage_events(memory_utils.snapshot_embedding_usage_history())
            reasoning_token_usage = memory_utils.summarize_usage_events(memo.client.snapshot_usage_history())
            recall_at_1 = compute_recall_at_k(qa.get("evidence", []), retrieval_results.get("retrieved_pages", []) or [], 1)
            recall_at_10 = compute_recall_at_k(qa.get("evidence", []), retrieval_results.get("retrieved_pages", []) or [], 10)
            em = exact_match(prediction, gold_answer)
            f1 = token_f1(prediction, gold_answer)
            em_scores.append(em)
            f1_scores.append(f1)
            page_lookup = _page_lookup(retrieval_results.get("retrieved_pages", []) or [])
            citations = [
                citation_id
                for citation_id in (retrieval_results.get("citations", []) or [])
                if str(citation_id) in page_lookup
            ]
            hit_ids = retrieval_results.get("hit_ids", [])
            salvage_count = int(retrieval_results.get("salvage_count", 0) or 0)
            citation_preview = memo.lifecycle.preview_nli_citations(
                prediction,
                citations,
                max_citations=max(1, len(citations)),
            )
            evaluation = build_evaluation_result(
                gold_answer=gold_answer,
                predicted_answer=prediction,
                gold_evidence_ids=qa.get("evidence", []),
                predicted_evidence_ids=get_locomo_predicted_evidence_ids(citations, retrieval_results.get("retrieved_pages", []) or []),
                citation_support_precision=support_precision_from_nli_preview(citation_preview),
                citation_ids=citations,
                hit_ids=hit_ids,
                answer_em=em,
                answer_f1=f1,
            )
            if trace_recorder is not None:
                trace_recorder.record_question_event(
                    {
                        "trace_context": dict(trace_context),
                        "sample_id": sample.get("sample_id"),
                        "question_index": index,
                        "question": question,
                        "gold_answer": gold_answer,
                        "prediction": prediction,
                        "latency_sec": round(latency, 3),
                        "citations": citations,
                        "hit_ids": hit_ids,
                        "memory_ids": list(dict.fromkeys(hit_ids + citations)),
                        "salvage_count": salvage_count,
                        "source_stats": dict(retrieval_results.get("source_stats", {})),
                        "recall_at_1": recall_at_1,
                        "recall_at_10": recall_at_10,
                        "retrieval_token_usage": dict(retrieval_token_usage),
                        "reasoning_token_usage": dict(reasoning_token_usage),
                        "scores": dict(evaluation.get("scores", {})),
                    }
                )
            if retrieval_results.get("hit_ids") and not args.benchmark_light:
                memo.lifecycle.schedule_nli_verify_citations(
                    prediction,
                    retrieval_results.get("hit_ids", [])[:3],
                    trace_context={**trace_context, "query_kind": "top_hit_nli"},
                )

            record = {
                "sample_id": sample.get("sample_id"),
                "question_index": index,
                "question": question,
                "gold_answer": gold_answer,
                "prediction": prediction,
                "category": qa.get("category"),
                "evidence": qa.get("evidence", []),
                "citations": citations,
                "hit_ids": hit_ids,
                "salvage_count": salvage_count,
                "source_stats": retrieval_results.get("source_stats", {}),
                "em": evaluation["scores"]["answer_em"],
                "f1": evaluation["scores"]["answer_f1"],
                "recall_at_1": recall_at_1,
                "recall_at_10": recall_at_10,
                "retrieval_token_usage": retrieval_token_usage,
                "reasoning_token_usage": reasoning_token_usage,
                "latency_sec": round(latency, 3),
                "citation_preview": citation_preview,
                "gold": evaluation["gold"],
                "pred": evaluation["pred"],
                "scores": evaluation["scores"],
                "answer_verifier": retrieval_results.get("answer_verifier", {}),
            }
            records.append(record)

            print(
                f"  [{index:03d}] EM={em:.0f} F1={f1:.2f} R@1={recall_at_1:.2f} R@10={recall_at_10:.2f} "
                f"latency={latency:.2f}s question={question[:70]}"
            )
    finally:
        memo.shutdown(wait_for_background_tasks=False)

    if trace_recorder is not None:
        trace_recorder.update_run_metadata(
            user_id=unique_user_id,
            question_count=len(records),
            ingested_memory_count=ingested_memory_count,
        )
        trace_path = trace_recorder.finalize(
            extra={
                "sample_id": sample.get("sample_id"),
                "sample_position": sample_position,
                "question_count": len(records),
                "ingested_memory_count": ingested_memory_count,
            }
        )

    score_summary = summarize_score_metrics(records)
    salvage_summary = summarize_salvage_metrics(records)
    runtime_summary = summarize_runtime_metrics(records)
    return {
        "sample_id": sample.get("sample_id"),
        "user_id": unique_user_id,
        "question_count": len(records),
        "em": score_summary["answer_em"],
        "f1": score_summary["answer_f1"],
        "recall_at_1": runtime_summary["recall_at_1"],
        "recall_at_10": runtime_summary["recall_at_10"],
        "latency_sec": runtime_summary["latency_sec"],
        "retrieval_token_usage": runtime_summary["retrieval_token_usage"],
        "reasoning_token_usage": runtime_summary["reasoning_token_usage"],
        "answer_score": score_summary["answer_score"],
        "citation_score": score_summary["citation_score"],
        "final": score_summary["final"],
        **salvage_summary,
        "records": records,
        "trace_path": trace_path,
    }


def resolve_trace_output_path(trace_output: str, sample: Dict, sample_position: int) -> Path:
    target = Path(trace_output).expanduser()
    sample_label = str(sample.get("sample_id", sample_position)).replace("/", "_")
    if not target.suffix:
        return target / f"locomo_trace_{sample_label}.json"
    return target


