def build_turn_window_memories(
    session: Dict[str, Any],
    session_doc_id: str,
    overview_page_id: str,
    window_size: int,
    window_overlap: int,
    max_chars: int,
) -> List[Dict[str, Any]]:
    windows = build_turn_windows(
        turns=session["turns"],
        anchor=session["anchor_dt"],
        window_size=window_size,
        window_overlap=window_overlap,
        max_chars=max_chars,
    )
    memories: List[Dict[str, Any]] = []
    session_id = session["session_id"]

    for index, window_turns in enumerate(windows, start=1):
        local_transcript_lines: List[str] = []
        dia_ids: List[str] = []
        for turn in window_turns:
            local_transcript_lines.extend(format_turn(turn, anchor=session["anchor_dt"]))
            dia_id = str(turn.get("dia_id", "")).strip()
            if dia_id:
                dia_ids.append(dia_id)

        dia_start = dia_ids[0] if dia_ids else ""
        dia_end = dia_ids[-1] if dia_ids else ""
        dia_range = f"{dia_start}-{dia_end}" if dia_start and dia_end and dia_start != dia_end else (dia_start or dia_end)

        body_parts = [
            f"Sample: {session['sample_id']}",
            f"Date: {session['date_time']}",
            f"Session: {session_id}",
            f"Window: {index}",
        ]
        if dia_range:
            body_parts.append(f"Dialogue IDs: {dia_range}")
        if session["session_summary"]:
            body_parts.extend(
                [
                    "Session Summary:",
                    annotate_text_with_time_resolution(session["session_summary"], session["anchor_dt"]),
                ]
            )
        body_parts.extend(["Transcript Window:"] + local_transcript_lines)

        memories.append(
            {
                "user_input": f"LoCoMo Session {session_id} Window {index}",
                "agent_response": "\n".join(body_parts),
                "metadata": {
                    "doc_id": f"{session_doc_id}_window_{index}",
                    "page_id": f"{session_doc_id}_window_{index}",
                    "session_group_id": session_doc_id,
                    "conversation_id": session["sample_id"],
                    "session_id": session_id,
                    "session_datetime": session["date_time"],
                    "chunk_scope": "turn_window",
                    "window_index": index,
                    "window_turn_count": len(window_turns),
                    "window_dia_ids": dia_ids,
                    "source_dataset": "locomo",
                    "topic": "LoCoMo Turn Window",
                    "pre_linked_ids": [overview_page_id],
                },
            }
        )

    return memories


def build_locomo_memory_entries(sample: Dict, session_id: int, args: argparse.Namespace) -> List[Dict[str, Any]]:
    session = build_session_components(sample, session_id)
    sample_key = sanitize_chunk_identifier(session["sample_id"])
    session_doc_id = f"{sample_key}_session_{session_id}"
    overview_page_id = f"{session_doc_id}_overview"

    memories: List[Dict[str, Any]] = [build_session_overview_memory(sample, session)]
    transcript_chars = estimate_transcript_chars(session["turns"], session["anchor_dt"])

    if transcript_chars <= args.session_transcript_max_chars:
        memories.append(build_session_transcript_memory(session, session_doc_id, overview_page_id))

    memories.extend(
        build_turn_window_memories(
            session=session,
            session_doc_id=session_doc_id,
            overview_page_id=overview_page_id,
            window_size=args.turn_window_size,
            window_overlap=args.turn_window_overlap,
            max_chars=args.turn_window_max_chars,
        )
    )
    return memories


def collect_page_evidence_lines(question: str, page: Dict[str, Any], limit: int = 4) -> List[str]:
    if limit <= 0:
        return []
    raw_text = page.get("raw_content") or page.get("agent_response") or ""
    if not raw_text:
        return []

    question_terms = extract_question_terms(question)
    temporal = question_is_temporal(question)
    scored: List[Tuple[float, str]] = []
    for line in str(raw_text).splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        score = score_evidence_line(question, stripped, question_terms=question_terms, temporal=temporal)
        if score > 0:
            scored.append((score, stripped))
    scored.sort(key=lambda item: item[0], reverse=True)

    result: List[str] = []
    for _, line in scored:
        if line in result:
            continue
        result.append(line)
        if len(result) >= limit:
            break
    return result


def build_context_block(
    question: str,
    retrieval_results: Dict,
    max_pages: int,
    *,
    mode: str = "full",
    lines_per_page: int = 4,
) -> str:
    pages = retrieval_results.get("retrieved_pages", [])[:max_pages]
    if not pages:
        return "No memory evidence retrieved."

    blocks = []
    focused_snippets = collect_focused_evidence_snippets(question, retrieval_results, limit=10)
    if focused_snippets:
        blocks.append("Focused Evidence:\n" + "\n".join(f"- {snippet}" for snippet in focused_snippets))
    relevant_lines = collect_relevant_evidence_lines(question, retrieval_results, limit=8)
    if relevant_lines:
        blocks.append("Relevant Lines:\n" + "\n".join(f"- {line}" for line in relevant_lines))

    if str(mode or "").strip().lower() == "compact":
        for page in pages:
            citation_id = page.get("citation_id") or page.get("page_id") or "unknown"
            prompt = str(page.get("user_input", "") or "").strip()
            if len(prompt) > 220:
                prompt = prompt[:217] + "..."
            evidence_lines = collect_page_evidence_lines(question, page, limit=lines_per_page)
            if evidence_lines:
                body = "Evidence:\n" + "\n".join(f"- {line}" for line in evidence_lines)
            else:
                snippet = page.get("summary") or page.get("agent_response") or page.get("raw_content") or ""
                snippet = " ".join(str(snippet).split())
                if len(snippet) > 420:
                    snippet = snippet[:417] + "..."
                body = f"Snippet: {snippet}"
            blocks.append("\n".join([f"[{citation_id}]", f"Prompt: {prompt}", body]))
        return "\n\n".join(blocks)

    for page in pages:
        citation_id = page.get("citation_id") or page.get("page_id") or "unknown"
        blocks.append(
            "\n".join(
                [
                    f"[{citation_id}]",
                    f"Prompt: {page.get('user_input', '')}",
                    f"Memory: {page.get('agent_response', '')}",
                ]
            )
        )
    return "\n\n".join(blocks)


