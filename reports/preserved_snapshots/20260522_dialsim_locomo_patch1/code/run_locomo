def _dedupe_queries(queries: List[str], question: str = "") -> List[str]:
    cleaned: List[str] = []
    seen = set()
    normalized_question = normalize_text(question)
    for query in queries or []:
        text = " ".join(str(query or "").split()).strip()
        if not text:
            continue
        key = normalize_text(text)
        if not key or key == normalized_question or key in seen:
            continue
        seen.add(key)
        cleaned.append(text)
    return cleaned


def build_retrieval_planner_prompt(question: str) -> str:
    return (
        "You are a retrieval planner for memory-grounded question answering.\n"
        "Decide what information must be retrieved before answering the question.\n"
        "Do not guess the answer. Do not inject likely answer strings unless they already appear in the question.\n"
        "Split dependencies into two kinds:\n"
        "- global_dependencies: broader background, profile, article/session overview, or stable context needed to understand the question.\n"
        "- local_dependencies: event-specific, relation-specific, temporal, location, list-item, or detail-level evidence directly needed for the answer.\n"
        "Return strict JSON only with this format:\n"
        "{\"need\": \"short description\", \"answer_mode\": \"fact|time|list|inference|binary\", "
        "\"global_dependencies\": [\"dep1\", \"dep2\"], \"local_dependencies\": [\"dep3\", \"dep4\"], "
        "\"queries\": [\"query1\", \"query2\"]}\n"
        "Generate 1 to 4 short retrieval queries. Queries should paraphrase the information need, not the answer.\n"
        "For binary or inference questions, global dependencies should usually include stable evidence about the person or relation.\n"
        "For factual or temporal questions, local dependencies should usually dominate.\n\n"
        f"Question: {question}"
    )


def _clean_dependency_values(values: List[Any]) -> List[str]:
    cleaned: List[str] = []
    seen = set()
    for value in values or []:
        text = " ".join(str(value or "").split()).strip()
        if not text:
            continue
        key = normalize_text(text)
        if not key or key in seen:
            continue
        seen.add(key)
        cleaned.append(text)
    return cleaned


def _compose_dependency_query(subject: str, dependency: str, question_terms: List[str], local: bool) -> str:
    pieces: List[str] = []
    if subject:
        pieces.append(subject)
    pieces.append(dependency)
    if local and question_terms:
        pieces.append(" ".join(question_terms[:4]))
    return " ".join(piece for piece in pieces if piece).strip()


def build_dependency_queries(
    question: str,
    answer_mode: str,
    global_dependencies: List[str],
    local_dependencies: List[str],
) -> Dict[str, List[str]]:
    names = extract_question_names(question)
    subject = " ".join(names) if names else "person"
    question_terms = sorted(extract_question_terms(question))

    global_queries = _dedupe_queries(
        [
            _compose_dependency_query(subject, dependency, question_terms, local=False)
            for dependency in global_dependencies
        ],
        question=question,
    )
    local_queries = _dedupe_queries(
        [
            _compose_dependency_query(subject, dependency, question_terms, local=True)
            for dependency in local_dependencies
        ],
        question=question,
    )

    if answer_mode in {"inference", "binary"} and not global_queries and subject:
        global_queries = _dedupe_queries(
            [f"{subject} stable traits preferences identity goals habits values"],
            question=question,
        )

    return {
        "global_queries": global_queries[:4],
        "local_queries": local_queries[:4],
    }


def plan_retrieval_queries(memo: Memoryos, question: str) -> Dict[str, Any]:
    prompt = build_retrieval_planner_prompt(question)
    planner_client = getattr(memo, "planner_client", memo.client)
    planner_model = getattr(memo, "planner_model", memo.llm_model)
    raw_response = planner_client.chat_completion(
        model=planner_model,
        messages=[{"role": "user", "content": prompt}],
        temperature=0.0,
        max_tokens=260,
        response_format={"type": "json_object"},
    )

    plan: Dict[str, Any] = {}
    try:
        parsed = json.loads(raw_response)
        if isinstance(parsed, dict):
            plan = parsed
    except Exception:
        plan = {}

    answer_mode = str(plan.get("answer_mode", "") or "").strip().lower()
    global_dependencies = _clean_dependency_values(
        plan.get("global_dependencies", []) or plan.get("focus_terms", [])
    )
    local_dependencies = _clean_dependency_values(plan.get("local_dependencies", []))
    dependency_queries = build_dependency_queries(
        question,
        answer_mode=answer_mode,
        global_dependencies=global_dependencies,
        local_dependencies=local_dependencies,
    )
    explicit_queries = _dedupe_queries(plan.get("queries", []), question=question)
    queries = _dedupe_queries(
        explicit_queries + dependency_queries["local_queries"] + dependency_queries["global_queries"],
        question=question,
    )
    return {
        "need": str(plan.get("need", "") or "").strip(),
        "answer_mode": answer_mode,
        "global_dependencies": global_dependencies[:8],
        "local_dependencies": local_dependencies[:8],
        "explicit_queries": explicit_queries[:4],
        "global_queries": list(dependency_queries["global_queries"]),
        "local_queries": list(dependency_queries["local_queries"]),
        "queries": queries[:6],
        "raw": raw_response,
    }


def annotate_retrieval_result(
    result: Dict[str, Any],
    planner_query_tier: str = "",
    query_text: str = "",
) -> Dict[str, Any]:
    annotated = dict(result or {})
    annotated_pages: List[Dict[str, Any]] = []
    for page in annotated.get("retrieved_pages", []) or []:
        page_copy = dict(page)
        tiers = [str(tier).strip().lower() for tier in page_copy.get("_planner_query_tiers", []) if str(tier).strip()]
        if planner_query_tier:
            tier = str(planner_query_tier).strip().lower()
            if tier and tier not in tiers:
                tiers.append(tier)
        page_copy["_planner_query_tiers"] = tiers
        queries = [str(item).strip() for item in page_copy.get("_planner_queries", []) if str(item).strip()]
        if query_text:
            clean_query = str(query_text).strip()
            if clean_query and clean_query not in queries:
                queries.append(clean_query)
        page_copy["_planner_queries"] = queries
        annotated_pages.append(page_copy)
    annotated["retrieved_pages"] = annotated_pages
    return annotated


def rerank_retrieval_results(question: str, retrieval_results: Dict) -> Dict:
    pages = list(retrieval_results.get("retrieved_pages", []))
    if not pages:
        return retrieval_results

    temporal = question_is_temporal(question)
    inference_mode = question_requires_inference(question)
    binary_mode = question_is_binary(question)
    adversarial_mode = question_is_adversarial(question)
    question_terms = extract_question_terms(question)
    question_phrases = extract_question_phrases(question)
    question_names = [name.lower() for name in extract_question_names(question)]
    session_scores: Dict[Any, float] = {}
    session_counts: Dict[Any, int] = {}

    def slot_rerank_adjustment(page: Dict[str, Any]) -> float:
        slot_rerank = page.get("slot_rerank", {})
        if not isinstance(slot_rerank, dict):
            slot_rerank = {}
        try:
            multiplier = float(slot_rerank.get("multiplier", page.get("slot_rerank_multiplier", 1.0)))
        except (TypeError, ValueError):
            multiplier = 1.0
        if abs(multiplier - 1.0) < 1e-6:
            return 0.0

        reason = str(slot_rerank.get("reason", ""))
        adjustment = 1.6 * (multiplier - 1.0)
        if reason.endswith("_match"):
            adjustment += 0.15
        elif "distractor" in reason:
            adjustment -= 0.15
        return round(adjustment, 6)

    def gap_session_key(page: Dict[str, Any]) -> Optional[str]:
        metadata = page.get("metadata", {}) if isinstance(page.get("metadata", {}), dict) else {}
        session_group_id = metadata.get("session_group_id")
        if session_group_id:
            return str(session_group_id)
        session_id = metadata.get("session_id")
        conversation_id = metadata.get("conversation_id")
        if session_id is not None and conversation_id:
            return f"{conversation_id}:{session_id}"
        if session_id is not None:
            return f"session:{session_id}"
        return None

    def build_gap_profiles(candidates: List[Dict[str, Any]]) -> Dict[str, Dict[str, Any]]:
        profiles: Dict[str, Dict[str, Any]] = {}
        for page in candidates:
            metadata = page.get("metadata", {}) if isinstance(page.get("metadata", {}), dict) else {}
            chunk_scope = metadata.get("chunk_scope")
            if chunk_scope not in {"session_overview", "turn_window"}:
                continue
            session_key = gap_session_key(page)
            if not session_key:
                continue
            profile = profiles.setdefault(session_key, {"overviews": [], "windows": []})
            record = {
                "page_id": page.get("citation_id") or page.get("page_id") or str(id(page)),
                "score": float(page.get("locomo_base_rerank_score", page.get("locomo_rerank_score", page.get("final_score", 0.0)))),
                "overlap": int(page.get("_locomo_query_overlap", 0)),
            }
            if chunk_scope == "session_overview":
                profile["overviews"].append(record)
            elif chunk_scope == "turn_window":
                profile["windows"].append(record)
        return profiles

    def gap_adjustment(page: Dict[str, Any], gap_profiles: Dict[str, Dict[str, Any]]) -> float:
        metadata = page.get("metadata", {}) if isinstance(page.get("metadata", {}), dict) else {}
        chunk_scope = metadata.get("chunk_scope")
        if chunk_scope not in {"session_overview", "turn_window"}:
            return 0.0
        session_key = gap_session_key(page)
        profile = gap_profiles.get(session_key or "")
        if not profile or not profile.get("overviews") or not profile.get("windows"):
            return 0.0

        current_page_id = page.get("citation_id") or page.get("page_id") or str(id(page))
        overviews = profile["overviews"]
        windows = profile["windows"]
        current_pool = overviews if chunk_scope == "session_overview" else windows
        current_record = next((record for record in current_pool if record["page_id"] == current_page_id), None)
        if current_record is None:
            return 0.0

        best_overview = max(overviews, key=lambda item: (item["overlap"], item["score"]))
        best_window = max(windows, key=lambda item: (item["overlap"], item["score"]))
        if chunk_scope == "session_overview":
            window_support = best_window["overlap"] >= max(1, current_record["overlap"])
            score_support = best_window["score"] >= (current_record["score"] * 0.72)
            if not (window_support or score_support):
                return 0.0
            adjustment = -0.65 if temporal else -0.85
            if best_window["overlap"] > current_record["overlap"]:
                adjustment -= 0.12
            if len(windows) >= 2:
                adjustment -= 0.05
            return round(max(-1.0, adjustment), 6)

        overview_support = current_record["overlap"] >= max(1, best_overview["overlap"])
        score_support = current_record["score"] >= (best_overview["score"] * 0.72)
        if not (overview_support or score_support):
            return 0.0
        adjustment = 0.22 if temporal else 0.32
        if current_record["overlap"] > best_overview["overlap"] or current_record["score"] >= (best_overview["score"] * 0.9):
            adjustment += 0.08
        return round(min(0.55, adjustment), 6)

    def graph_1hop_adjustment(page: Dict[str, Any]) -> float:
        if page.get("_source") != "GRAPH_1HOP":
            return 0.0
        graph_meta = page.get("graph_1hop", {}) if isinstance(page.get("graph_1hop"), dict) else {}
        matched_entities = graph_meta.get("matched_entities", []) or []
        query_overlap = int(graph_meta.get("query_overlap", 0) or 0)
        adjustment = 0.10 + (0.10 * len(matched_entities)) + (0.06 * query_overlap)
        if inference_mode or adversarial_mode:
            adjustment += 0.12
        if temporal:
            adjustment -= 0.10
        if not matched_entities and query_overlap == 0:
            adjustment -= 0.25
        return round(max(-0.25, min(0.48, adjustment)), 6)

    def planner_tier_adjustment(page: Dict[str, Any]) -> float:
        tiers = [str(tier).strip().lower() for tier in page.get("_planner_query_tiers", []) if str(tier).strip()]
        if not tiers:
            return 0.0

        metadata = page.get("metadata", {}) if isinstance(page.get("metadata", {}), dict) else {}
        chunk_scope = str(metadata.get("chunk_scope", "") or "")
        adjustment = 0.0
        if "global" in tiers:
            if chunk_scope == "session_overview":
                adjustment += 0.34
            elif chunk_scope == "session_transcript":
                adjustment += 0.16
            elif chunk_scope == "turn_window":
                adjustment -= 0.08
        if "local" in tiers:
            if chunk_scope == "turn_window":
                adjustment += 0.28
            elif chunk_scope == "session_transcript":
                adjustment += 0.10
            elif chunk_scope == "session_overview":
                adjustment -= 0.18 if not temporal else -0.08
        if {"global", "local"}.issubset(set(tiers)):
            adjustment += 0.08
        if (inference_mode or binary_mode) and "global" in tiers:
            adjustment += 0.12
        if (not inference_mode and not binary_mode) and "local" in tiers:
            adjustment += 0.05
        return round(max(-0.3, min(0.6, adjustment)), 6)

    def best_line_support_score(raw_text: str) -> float:
        best = 0.0
        if not raw_text:
            return best
        for line in str(raw_text).splitlines():
            stripped = line.strip()
            if not stripped:
                continue
            line_lower = stripped.lower()
            line_terms = set(re.findall(r"[a-z0-9]+", line_lower))
            score = float(len(question_terms & line_terms))
            if score <= 0.0 and not temporal and not question_names and not question_phrases:
                continue

            for name in question_names:
                if name and name in line_lower:
                    score += 1.2

            for phrase in question_phrases:
                if phrase in line_lower:
                    score += 1.6 if len(phrase.split()) >= 3 else 1.0

            if temporal:
                if "exact time:" in line_lower:
                    score += 4.0
                if "resolved time:" in line_lower or "resolved relative times:" in line_lower:
                    score += 2.5
                if "date:" in line_lower:
                    score += 1.8
                if re.search(r"\b\d{1,2}\s+[a-z]+,?\s+\d{4}\b", line_lower):
                    score += 3.2
                if "yesterday ->" in line_lower or "today ->" in line_lower or "tomorrow ->" in line_lower:
                    score += 2.2

            best = max(best, score)
        return best

    prepared: List[Tuple[Dict[str, Any], Dict[str, Any], str, set]] = []
    term_df: Counter = Counter()
    for page in pages:
        metadata = page.get("metadata", {}) if isinstance(page.get("metadata", {}), dict) else {}
        text = "\n".join(
            [
                str(page.get("user_input", "")),
                str(page.get("summary", "")),
                str(page.get("raw_content", "")),
            ]
        )
        text_lower = text.lower()
        text_terms = set(re.findall(r"[a-z0-9]+", text_lower))
        overlap_terms = question_terms & text_terms
        for term in overlap_terms:
            term_df[term] += 1
        prepared.append((page, metadata, text_lower, text_terms))

    candidate_count = max(1, len(prepared))
    idf_weights = {
        term: (math.log((candidate_count + 1.0) / (float(df) + 1.0)) + 1.0) for term, df in term_df.items()
    }

    for page, metadata, text_lower, text_terms in prepared:
        base_score = float(page.get("final_score", page.get("score", 0.0)))
        overlap_terms = question_terms & text_terms
        lexical_overlap = len(overlap_terms)
        page["_locomo_query_overlap"] = lexical_overlap
        weighted_overlap = sum(idf_weights.get(term, 0.0) for term in overlap_terms)
        page["_locomo_weighted_overlap"] = round(weighted_overlap, 6)
        score = base_score + (0.22 * lexical_overlap) + (0.08 * weighted_overlap)

        evidence_ids = extract_locomo_evidence_ids_from_page(page)
        evidence_count = len(evidence_ids)
        page["_locomo_evidence_id_count"] = evidence_count
        if evidence_count:
            score += 0.34 + min(0.18, 0.015 * evidence_count)
        else:
            # LoCoMo recall is evaluated via dialogue evidence IDs; favor pages that carry them.
            score -= 0.18
            if metadata.get("chunk_scope") == "session_overview":
                score -= 0.25
            if page.get("_source") == "STM_HOT":
                score -= 0.22

        page_text_for_lines = page.get("raw_content") or page.get("agent_response") or ""
        best_line_score = best_line_support_score(page_text_for_lines)
        page["_locomo_best_line_score"] = round(best_line_score, 6)
        score += min(1.8, 0.09 * best_line_score)

        slot_adjustment = slot_rerank_adjustment(page)
        page["locomo_slot_adjustment"] = slot_adjustment
        score += slot_adjustment
        graph_adjustment = graph_1hop_adjustment(page)
        page["locomo_graph_adjustment"] = graph_adjustment
        score += graph_adjustment
        planner_adjustment = planner_tier_adjustment(page)
        page["locomo_planner_tier_adjustment"] = planner_adjustment
        score += planner_adjustment

        for name in question_names:
            if name and name in text_lower:
                score += 0.75

        for phrase in question_phrases:
            if phrase in text_lower:
                score += 0.9 if len(phrase.split()) >= 3 else 0.45

        chunk_scope = metadata.get("chunk_scope")
        if temporal:
            if chunk_scope == "turn_window":
                score += 1.15
            elif chunk_scope == "session_transcript":
                score += 0.9
            elif chunk_scope == "session_overview":
                score += 0.35
            if "exact time:" in text_lower:
                score += 1.5
            if "resolved time:" in text_lower or "resolved relative times:" in text_lower:
                score += 1.0
            if re.search(r"\b\d{1,2}\s+[a-z]+,?\s+\d{4}\b", text_lower):
                score += 0.85
        elif inference_mode:
            if chunk_scope == "session_overview":
                score += 0.8
            elif chunk_scope == "session_transcript":
                score += 0.35
            else:
                score += 0.15
        else:
            if chunk_scope == "turn_window":
                score += 0.55
            elif chunk_scope == "session_transcript":
                score += 0.3
            elif chunk_scope == "session_overview":
                score += 0.0

        page["locomo_base_rerank_score"] = round(score, 6)

    gap_band_size = max(8, min(len(pages), 12))
    prelim_candidates = sorted(
        pages,
        key=lambda item: float(item.get("locomo_base_rerank_score", item.get("final_score", item.get("score", 0.0)))),
        reverse=True,
    )[:gap_band_size]
    gap_profiles = build_gap_profiles(prelim_candidates)

    for page in pages:
        metadata = page.get("metadata", {}) if isinstance(page.get("metadata", {}), dict) else {}
        score = float(page.get("locomo_base_rerank_score", page.get("final_score", page.get("score", 0.0))))
        gap_delta = gap_adjustment(page, gap_profiles)
        page["locomo_gap_adjustment"] = gap_delta
        score += gap_delta
        page["locomo_rerank_score"] = round(score, 6)
        session_id = metadata.get("session_id")
        if session_id is not None:
            session_scores[session_id] = session_scores.get(session_id, 0.0) + score
            session_counts[session_id] = session_counts.get(session_id, 0) + 1

    for page in pages:
        metadata = page.get("metadata", {}) if isinstance(page.get("metadata", {}), dict) else {}
        session_id = metadata.get("session_id")
        score = float(page.get("locomo_rerank_score", page.get("final_score", page.get("score", 0.0))))
        if session_id is not None:
            lexical_overlap = int(page.get("_locomo_query_overlap", 0) or 0)
            evidence_count = int(page.get("_locomo_evidence_id_count", 0) or 0)
            if lexical_overlap > 0 or evidence_count > 0:
                score += min(0.6, 0.05 * session_counts.get(session_id, 0))
                score += min(0.4, 0.012 * session_scores.get(session_id, 0.0))
        page["locomo_rerank_score"] = round(score, 6)

    pages.sort(
        key=lambda item: (
            float(item.get("locomo_rerank_score", 0.0)),
            int(item.get("_locomo_evidence_id_count", 0) or 0),
            int(item.get("_locomo_query_overlap", 0) or 0),
            float(item.get("slot_rerank_multiplier", item.get("slot_rerank", {}).get("multiplier", 1.0))),
            float(item.get("final_score", item.get("score", 0.0))),
        ),
        reverse=True,
    )

    reranked = dict(retrieval_results)
    reranked["retrieved_pages"] = pages
    reranked["hit_ids"] = [page.get("citation_id") or page.get("page_id") for page in pages if page.get("citation_id") or page.get("page_id")]
    return reranked


def merge_retrieval_results(primary: Dict, additional_results: List[Dict]) -> Dict:
    merged = dict(primary)
    page_map: Dict[Any, Dict[str, Any]] = {}
    page_order: List[Any] = []
    merged_hit_ids: List[str] = []
    seen_hits = set()
    merged_source_stats: Dict[str, int] = {}
    merged_salvage_count = 0

    for result in [primary, *additional_results]:
        for page in result.get("retrieved_pages", []):
            page_key = (
                page.get("page_id")
                or page.get("chunk_id")
                or page.get("id")
                or page.get("doc_id")
                or str(id(page))
            )
            existing = page_map.get(page_key)
            if existing is None:
                page_map[page_key] = dict(page)
                page_order.append(page_key)
            else:
                better_page = page if _page_rank_score(page) >= _page_rank_score(existing) else existing
                merged_page = dict(existing)
                for source_page in (existing, page):
                    for key, value in source_page.items():
                        if value not in (None, "", [], {}):
                            merged_page[key] = value
                merged_page["_planner_query_tiers"] = sorted(
                    {
                        str(tier).strip()
                        for source_page in (existing, page)
                        for tier in (source_page.get("_planner_query_tiers", []) or [])
                        if str(tier).strip()
                    }
                )
                merged_page["_planner_queries"] = [
                    query
                    for query in dict.fromkeys(
                        str(query).strip()
                        for source_page in (existing, page)
                        for query in (source_page.get("_planner_queries", []) or [])
                        if str(query).strip()
                    )
                ]
                merged_page.update(better_page)
                page_map[page_key] = merged_page

        for hit_id in result.get("hit_ids", []):
            if hit_id in seen_hits:
                continue
            seen_hits.add(hit_id)
            merged_hit_ids.append(hit_id)

        for key, value in result.get("source_stats", {}).items():
            if isinstance(value, (int, float)):
                merged_source_stats[key] = merged_source_stats.get(key, 0) + int(value)
        merged_salvage_count += int(result.get("salvage_count", 0) or 0)

    merged["retrieved_pages"] = [page_map[key] for key in page_order]
    merged["hit_ids"] = merged_hit_ids
    if merged_source_stats:
        merged["source_stats"] = merged_source_stats
    merged["salvage_count"] = merged_salvage_count
    return merged


def _page_planner_tiers(page: Dict[str, Any]) -> List[str]:
    return [
        str(tier).strip().lower()
        for tier in (page.get("_planner_query_tiers", []) or [])
        if str(tier).strip()
    ]


def apply_planner_channel_quota(
    retrieval_results: Dict[str, Any],
    max_results: int,
    *,
    inference_mode: bool = False,
    binary_mode: bool = False,
    list_mode: bool = False,
    temporal_mode: bool = False,
) -> Dict[str, Any]:
    pages = list(retrieval_results.get("retrieved_pages", []) or [])
    if not pages or max_results <= 0:
        return retrieval_results

    if inference_mode or binary_mode:
        global_quota = min(max_results - 1, max(1, round(max_results * 0.4)))
    elif temporal_mode or list_mode:
        global_quota = 1 if max_results > 1 else 0
    else:
        global_quota = 1 if max_results > 2 else 0
    local_quota = max(1, max_results - global_quota)

    ordered_groups = ["global", "local", "other"] if (inference_mode or binary_mode) else ["local", "global", "other"]
    selected: List[Dict[str, Any]] = []
    selected_ids = set()

    def page_id(page: Dict[str, Any]) -> str:
        return str(page.get("citation_id") or page.get("page_id") or page.get("id") or id(page))

    def channel_matches(page: Dict[str, Any], channel: str) -> bool:
        tiers = set(_page_planner_tiers(page))
        if channel == "global":
            return "global" in tiers
        if channel == "local":
            return bool({"local", "primary"} & tiers) or not tiers
        return True

    def pick(channel: str, quota: int) -> None:
        if quota <= 0:
            return
        for page in pages:
            pid = page_id(page)
            if pid in selected_ids:
                continue
            if not channel_matches(page, channel):
                continue
            selected.append(page)
            selected_ids.add(pid)
            if len([item for item in selected if channel_matches(item, channel)]) >= quota:
                break

    for channel in ordered_groups:
        if channel == "global":
            pick(channel, global_quota)
        elif channel == "local":
            pick(channel, local_quota)

    for page in pages:
        pid = page_id(page)
        if pid in selected_ids:
            continue
        selected.append(page)
        selected_ids.add(pid)
        if len(selected) >= max_results:
            break

    trimmed = dict(retrieval_results)
    trimmed["retrieved_pages"] = selected[:max_results]
    trimmed["hit_ids"] = [
        page.get("citation_id") or page.get("page_id")
        for page in trimmed["retrieved_pages"]
        if page.get("citation_id") or page.get("page_id")
    ]
    return trimmed


def apply_slot_filtering(question: str, retrieval_results: Dict) -> Dict:
    pages = list(retrieval_results.get("retrieved_pages", []) or [])
    if not pages:
        return retrieval_results

    expected_slot = ""
    for page in pages:
        slot_rerank = page.get("slot_rerank", {})
        if isinstance(slot_rerank, dict) and slot_rerank.get("expected_slot"):
            expected_slot = str(slot_rerank.get("expected_slot") or "").strip().upper()
            break
    if expected_slot not in {"LOCATION", "TIME", "PRODUCT", "FOOD"}:
        return retrieval_results

    penalized_count = 0
    for page in pages:
        slot_rerank = page.get("slot_rerank", {}) if isinstance(page.get("slot_rerank", {}), dict) else {}
        observed_slots = {
            str(slot).strip().upper()
            for slot in (slot_rerank.get("observed_slots", []) or [])
            if str(slot).strip()
        }
        lexical_overlap = int(page.get("_locomo_query_overlap", 0) or 0)
        reason = str(slot_rerank.get("reason", "") or "")
        planner_tiers = set(_page_planner_tiers(page))

        adjustment = 0.0
        explicit_match = (
            expected_slot in observed_slots
            or (expected_slot == "LOCATION" and reason == "location_match")
            or (expected_slot == "TIME" and reason == "time_match")
            or (expected_slot == "PRODUCT" and reason == "product_match")
            or (expected_slot == "FOOD" and reason == "food_match")
        )
        if explicit_match:
            adjustment += 0.04
        elif "distractor" in reason and lexical_overlap < 2 and "global" not in planner_tiers:
            adjustment -= 0.22
        elif not observed_slots and lexical_overlap == 0 and "global" not in planner_tiers:
            adjustment -= 0.06

        page["slot_filter_adjustment"] = round(adjustment, 6)
        if adjustment < 0:
            penalized_count += 1
        if adjustment != 0.0:
            score = float(page.get("locomo_rerank_score", page.get("final_score", page.get("score", 0.0))))
            page["locomo_rerank_score"] = round(score + adjustment, 6)

    pages.sort(
        key=lambda item: (
            float(item.get("locomo_rerank_score", item.get("final_score", item.get("score", 0.0)))),
            float(item.get("slot_rerank_multiplier", item.get("slot_rerank", {}).get("multiplier", 1.0))),
            float(item.get("final_score", item.get("score", 0.0))),
        ),
        reverse=True,
    )

    filtered = dict(retrieval_results)
    filtered["retrieved_pages"] = pages
    filtered["hit_ids"] = [
        page.get("citation_id") or page.get("page_id")
        for page in pages
        if page.get("citation_id") or page.get("page_id")
    ]
    filtered["slot_filtering"] = {
        "expected_slot": expected_slot,
        "removed_count": 0,
        "kept_count": len(pages),
        "penalized_count": penalized_count,
        "applied": penalized_count > 0,
    }
    return filtered


def split_into_evidence_units(text: str) -> List[str]:
    text = str(text or "")
    if not text:
        return []

    normalized = text.replace(" Transcript:", "\nTranscript:")
    normalized = re.sub(r"(\[D\d+:\d+\])", r"\n\1", normalized)
    normalized = re.sub(r"(Observations:|Event Summary:|Session Summary:|Resolved Event Facts:|Resolved Relative Times:)", r"\n\1", normalized)
    normalized = re.sub(r"\s+- ([A-Z][a-zA-Z]+:)", r"\n- \1", normalized)

    units: List[str] = []
    for chunk in normalized.splitlines():
        chunk = " ".join(chunk.split()).strip()
        if not chunk:
            continue
        parts = re.split(r"(?<=[.!?])\s+(?=[A-Z\[])", chunk)
        for part in parts:
            cleaned = part.strip()
            if cleaned:
                units.append(cleaned)
    return units


def collect_focused_evidence_snippets(question: str, retrieval_results: Dict, limit: int = 10) -> List[str]:
    question_terms = {
        token
        for token in re.findall(r"[a-z0-9]+", question.lower())
        if token not in {"what", "when", "where", "which", "year", "how", "long", "did", "does", "do", "is", "the", "a", "an", "and", "her", "his", "their", "for", "next", "with", "together"}
    }
    scored: List[Tuple[float, str]] = []

    for page in retrieval_results.get("retrieved_pages", []):
        raw_text = page.get("raw_content") or page.get("agent_response", "")
        for unit in split_into_evidence_units(raw_text):
            unit_terms = set(re.findall(r"[a-z0-9]+", unit.lower()))
            overlap = len(question_terms & unit_terms)
            if overlap == 0:
                continue
            score = float(overlap)
            lower = unit.lower()
            if "resolved time:" in lower or "exact time:" in lower:
                score += 0.5
            if any(marker in lower for marker in ["because", "helps", "helped", "focused on", "plan", "recommend", "favorite", "took", "visit", "visited", "play", "games", "cats", "mother", "shelter", "husband", "partner"]):
                score += 0.35
            if len(unit) > 280:
                score -= 0.25
            scored.append((score, unit))

    scored.sort(key=lambda item: item[0], reverse=True)
    result: List[str] = []
    for _, unit in scored:
        if unit not in result:
            result.append(unit)
        if len(result) >= limit:
            break
    return result


def normalize_list_item(item: str) -> str:
    item = re.sub(r"^\W+|\W+$", "", str(item or "").strip())
    item = re.sub(r"\s+", " ", item)
    return item


def dedupe_list_items(items: List[str]) -> List[str]:
    normalized_seen = set()
    result: List[str] = []
    for item in items:
        cleaned = normalize_list_item(item)
        if not cleaned:
            continue
        key = normalize_text(cleaned)
        if key in normalized_seen:
            continue
        normalized_seen.add(key)
        result.append(cleaned)
    return result


